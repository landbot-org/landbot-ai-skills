#!/usr/bin/env bash
# Talk to the Landbot Bots API v0-alpha.
#
#   lb GET  /blocks
#   lb POST /bots '{"name":"Demo","channel_family":"landbot"}'
#   lb PUT  /bots/<uuid>/draft @payload.json
#
# The path is appended to $LANDBOT_API_URL, so it starts at the version root: `/bots`,
# not `/v0-alpha/bots`. A body is either inline JSON or `@file`.
#
# One exception: `/ai-agents` is a door onto the API that owns agents, and it did not move with
# this one — it is served under `/v3` alone. A path to it goes to the `/v3` beside $LANDBOT_API_URL
# (`https://api.landbot.io/v3`, `http://localhost:8000/api/v3`), or to $LANDBOT_AGENTS_API_URL when
# that is set.
#
# Writes `HTTP <code>` to stderr and the body to stdout, and exits non-zero from 400 up,
# so a failure is never read as a success. The token is never printed.
#
# Three draft safeguards run on their own (scripts/draft-check), because a person forgets and so
# does an agent:
#   - after every successful write to /bots/<id>/draft…, the draft is saved as "what this plugin
#     last wrote";
#   - before such a write, if the draft no longer matches that snapshot, a WARNING says what changed
#     (an edit in the builder, or a builder tab saving an old copy over this plugin's work);
#   - before POST /bots/<id>/versions (publish), `draft-check gate` runs, and a BLOCK refuses the
#     publish: nothing is sent.
set -uo pipefail
HERE="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

BASE="${LANDBOT_API_URL:-https://api.landbot.io/v0-alpha}"
BASE="${BASE%/}"
AGENTS_BASE="${LANDBOT_AGENTS_API_URL:-${BASE%/*}/v3}"
KEYCHAIN_SERVICE="${LANDBOT_TOKEN_KEYCHAIN_SERVICE:-landbot-api-token}"

VERSION="0.4.0"
if [ "${1:-}" = "--version" ]; then echo "landbot-flows $VERSION"; exit 0; fi

# Every request says it comes from this plugin, its version and which agent ran it, so Landbot can
# count plugin use per version and see where calls fail. Nothing else is added: no body, no path
# the API does not already receive, no user or machine id.
if [ -n "${CLAUDECODE:-}" ]; then AGENT="claude-code"
elif [ -n "${CODEX_SANDBOX:-}${CODEX_HOME:-}${CODEX_MANAGED_BY_NPM:-}" ]; then AGENT="codex"
elif [ -n "${CURSOR_TRACE_ID:-}${CURSOR_AGENT:-}" ]; then AGENT="cursor"
else AGENT="other"; fi
USER_AGENT="landbot-plugin/$VERSION (landbot-flows; agent=$AGENT)"
if [ "$#" -lt 2 ]; then
  echo "usage: lb <METHOD> <PATH> [JSON|@FILE]" >&2
  exit 64
fi

METHOD="$1"
PATH_="$2"
BODY="${3:-}"

case "$PATH_" in
/ai-agents | /ai-agents/*) BASE="${AGENTS_BASE%/}" ;;
esac

# The API refuses a bot name over 50 characters (422 bot_name_not_accepted). Say so before the call,
# so a create never fails on its name. Covers POST /bots only; a rename is not checked here.
# The picker→strftime pairs the API's own enum allows. Any params object that carries a
# pickerFormat is checked, wherever it sits in the body (add-blocks, PATCH one block, PUT diagram).
DATE_FORMAT_CHECK='
  def want: {"yyyy/MM/dd":"%Y/%m/%d","yy/MM/dd":"%y/%m/%d","dd/MM/yyyy":"%d/%m/%Y",
             "dd/MM/yy":"%d/%m/%y","MM/dd/yy":"%m/%d/%y","MM/dd/yyyy":"%m/%d/%Y"};
  [ .. | objects | select(has("pickerFormat") and (.pickerFormat != null))
    | (want[.pickerFormat]) as $w
    | (if (.format | type) == "array" then .format elif (.format | type) == "string" then [.format]
       else ["%Y/%m/%d"] end) as $have
    | select($w != null and ($have | index($w) | not))
    | "a date block writes \(.pickerFormat) but accepts \($have | join(", ")); it needs \($w) in \"format\"."
  ] | first // empty'

MAX_NAME=50
if [ "$METHOD" = "POST" ] && { [ "$PATH_" = "/bots" ] || [ "$PATH_" = "/bots/" ]; } && [ -n "$BODY" ] && command -v jq >/dev/null 2>&1; then
  case "$BODY" in
  @*) name_len="$(jq -r '(.name // "") | length' < "${BODY#@}" 2>/dev/null)" ;;
  *)  name_len="$(printf '%s' "$BODY" | jq -r '(.name // "") | length' 2>/dev/null)" ;;
  esac
  case "$name_len" in ''|*[!0-9]*) name_len=0 ;; esac
  if [ "$name_len" -gt "$MAX_NAME" ]; then
    echo "refusing: the bot name is $name_len characters; Landbot accepts at most $MAX_NAME. Shorten it and create again. Nothing was sent." >&2
    exit 65
  fi
fi

# An `ask_date` block accepts only the patterns listed in `format` (strftime), while the calendar
# writes the date in `pickerFormat`. Set the picker alone and every date the visitor sends is
# refused in a loop: the API reports no violation, the publish answers 201, and only a walk of the
# chat shows it. So refuse a write whose two formats disagree, before it is sent.
if [ "$METHOD" != "GET" ] && [ "$METHOD" != "DELETE" ] && [ -n "$BODY" ] && command -v jq >/dev/null 2>&1; then
  case "$BODY" in
  @*) date_bad="$(jq -r "$DATE_FORMAT_CHECK" < "${BODY#@}" 2>/dev/null)" ;;
  *)  date_bad="$(printf '%s' "$BODY" | jq -r "$DATE_FORMAT_CHECK" 2>/dev/null)" ;;
  esac
  if [ -n "${date_bad:-}" ]; then
    echo "refusing: $date_bad" >&2
    echo "The block accepts only the patterns in \"format\"; the calendar writes \"pickerFormat\". Mismatched, every date the visitor sends is rejected in a loop and nothing in the API says so. Set both. Nothing was sent." >&2
    exit 65
  fi
fi

# A question keeps its words twice: `text` (the builder) and `richText` (what the visitor's chat shows).
# A write that carries a `richText` saying something else than its `text` (typically copied from an
# earlier read) changes the builder and not the chat: 200, no violation, a clean publish, and visitors
# keep the old words (verified 2026-09-23). Leaving the rich copy out is safe on every write: add-blocks
# and PATCH derive it, and after a PUT /draft it is stored empty and the chat shows `text` (both verified
# 2026-09-23). So refuse a write whose two copies disagree, before it is sent. The comparison is in
# richtext.jq: every character counts but tags, entities, markdown and spacing, so "$1.00" and "$100"
# differ; only wording that itself carries HTML is not compared.
RICH_CHECK='include "richtext";
  [ .. | objects | . as $o
    | (["text","richText"], ["errorText","richErrorText"])
    | select(($o[.[0]] | type) == "string" and ($o[.[1]] | type) == "string" and $o[.[1]] != "")
    | select(comparable($o[.[0]]))
    | select(rich_differs($o[.[0]]; $o[.[1]]))
    | "\(.[1]) says \"\($o[.[1]] | rich_plain | .[0:50])\" but \(.[0]) says \"\($o[.[0]] | text_plain | .[0:50])\""
  ] | first // empty'
if [ "$METHOD" != "GET" ] && [ "$METHOD" != "DELETE" ] && [ -n "$BODY" ] && command -v jq >/dev/null 2>&1; then
  case "$BODY" in
  @*) rich_bad="$(jq -L "$HERE" -r "$RICH_CHECK" < "${BODY#@}" 2>/dev/null)" || rich_bad="the display-copy check could not run (jq -L $HERE richtext.jq)" ;;
  *)  rich_bad="$(printf '%s' "$BODY" | jq -L "$HERE" -r "$RICH_CHECK" 2>/dev/null)" || rich_bad="the display-copy check could not run (jq -L $HERE richtext.jq)" ;;
  esac
  if [ -n "${rich_bad:-}" ]; then
    echo "refusing: $rich_bad." >&2
    echo "Visitors would keep seeing the rich copy. Leave richText/rawText (and richErrorText/rawErrorText) out of the write: the chat then shows the plain text. Nothing was sent." >&2
    exit 65
  fi
fi

TOKEN="${LANDBOT_API_TOKEN:-}"
if [ -z "$TOKEN" ] && command -v security >/dev/null 2>&1; then
  TOKEN="$(security find-generic-password -a "$USER" -s "$KEYCHAIN_SERVICE" -w 2>/dev/null || true)"
fi
if [ -z "$TOKEN" ]; then
  echo "no token: set LANDBOT_API_TOKEN, or store one in the keychain under '$KEYCHAIN_SERVICE'" >&2
  exit 77
fi

# A create that looked like it failed is often a create that worked: the bot exists a few seconds
# later. So before POST /bots, look for a bot with the same name created in the last 15 minutes and
# refuse to make a second one; read that bot instead. (GET /bots lists the most recently edited
# bots first, so a bot created minutes ago is on the first page.)
DUP_WINDOW_S=900
if [ "$METHOD" = "POST" ] && { [ "$PATH_" = "/bots" ] || [ "$PATH_" = "/bots/" ]; } && [ -n "$BODY" ] && command -v jq >/dev/null 2>&1; then
  case "$BODY" in
  @*) new_name="$(jq -r '.name // empty' < "${BODY#@}" 2>/dev/null)" ;;
  *)  new_name="$(printf '%s' "$BODY" | jq -r '.name // empty' 2>/dev/null)" ;;
  esac
  if [ -n "$new_name" ]; then
    recent="$(printf 'header = "Authorization: Token %s"\n' "$TOKEN" | curl -sS -f "$BASE/bots" -A "$USER_AGENT" --config - 2>/dev/null)" || recent=""
    dup="$(printf '%s' "$recent" | jq -r --arg n "$new_name" --argjson w "$DUP_WINDOW_S" '
      [(.data // [])[] | select(.name == $n)
        | select((now - ((.created_at // "1970-01-01T00:00:00") | sub("\\..*$"; "") | strptime("%Y-%m-%dT%H:%M:%S") | mktime)) < $w)
        | "\(.id) (created \(.created_at) UTC)"] | first // empty' 2>/dev/null)"
    if [ -n "$dup" ]; then
      echo "refusing: a bot named \"$new_name\" was created in the last 15 minutes: $dup." >&2
      echo "If an earlier create looked like it failed, it probably worked: read that bot (lb GET /bots/<uuid>) and carry on with it. For a genuinely new bot, use a different name. Nothing was sent." >&2
      exit 65
    fi
  fi
fi

DC="$HERE/draft-check"
DRAFT_BOT=""
BARE_PATH="${PATH_%%\?*}"; BARE_PATH="${BARE_PATH%%#*}"
if [ "$METHOD" != "GET" ] && [[ "$BARE_PATH" =~ ^/bots/([A-Za-z0-9-]+)/draft ]]; then DRAFT_BOT="${BASH_REMATCH[1]}"; fi
if [ "$METHOD" != "GET" ] && [[ "$BARE_PATH" =~ ^/+bots/+([A-Za-z0-9-]+)/+versions/*$ ]]; then
  if [ ! -x "$DC" ]; then
    echo "refusing to publish: the draft check ($DC) is missing or not executable, so the draft cannot be checked. Reinstall the plugin. Nothing was published." >&2
    exit 65
  fi
  gate_out="$("$DC" gate "${BASH_REMATCH[1]}" 2>&1)"; gate_rc=$?
  printf '%s\n' "$gate_out" >&2
  if [ "$gate_rc" -ne 0 ]; then
    echo "refusing to publish: the draft did not pass the checks above (draft-check gate exit $gate_rc). Nothing was published." >&2
    exit 65
  fi
fi
# Around a draft write: note the draft before it, and what the write itself is expected to touch, so a
# change someone else makes meanwhile is recorded as pending instead of being absorbed into the snapshot.
EXPECT=""
if [ -n "$DRAFT_BOT" ] && [ -x "$DC" ]; then
  case "$BODY" in @*) body_json="$(cat "${BODY#@}" 2>/dev/null)" ;; *) body_json="$BODY" ;; esac
  path_id=""; [[ "$BARE_PATH" =~ ^/bots/[A-Za-z0-9-]+/draft/blocks/([A-Za-z0-9_$-]+)/*$ ]] && path_id="${BASH_REMATCH[1]}"
  EXPECT="$(printf '%s' "${body_json:-null}" | jq -c --arg pid "$path_id" --arg m "$METHOD" --arg p "$BARE_PATH" '
    def node_of: {params: (.params // null), name: (.name // null)};
    def conn_of($kind): if type == "object" then {kind: $kind, sourcePath: (.sourcePath // .source_path), targetPath: (.targetPath // .target_path), type, id} else {kind: $kind, id: .} end;
    (. // {}) as $b |
    if $m == "PUT" then
      { put: { nodes: (($b.diagram.nodes // {}) | with_entries(.value |= {params: (.params // {}), name: (.name // null), template: (.template // null)})),
               conns: [ ($b.diagram.connections // {}) | (if type == "object" then to_entries[] | (.value + {id: .key}) else .[] end) | conn_of("add") ] } }
    elif ($p | test("/draft/blocks/[^/]+/*$")) and $m == "DELETE" then {nodes: {($pid): {delete: true}}, delete_incident: [$pid]}
    elif ($p | test("/draft/blocks/[^/]+/*$")) then {nodes: {($pid): ($b | node_of)}}
    elif ($p | test("/draft/blocks/*$")) and $m == "POST" then
      { nodes: ([ ($b.blocks // [])[] | select(.id) | {key: .id, value: (node_of + {added: true})} ] | from_entries),
        auto_added: ([ ($b.blocks // [])[] | select(.id | not) ] | length),
        conns: [ ($b.connections // [])[] | conn_of("add") ] }
    elif ($p | test("/draft/*$")) and $m == "PATCH" then
      { nodes: ([ ($b.blocks.add // [])[] | select(.id) | {key: .id, value: (node_of + {added: true})} ]
                + [ ($b.blocks.update // [])[] | select(.id) | {key: .id, value: node_of} ]
                + [ ($b.blocks.delete // [])[] | (if type == "string" then . else .id end) | select(.) | {key: ., value: {delete: true}} ] | from_entries),
        auto_added: ([ ($b.blocks.add // [])[] | select(.id | not) ] | length),
        delete_incident: [ ($b.blocks.delete // [])[] | (if type == "string" then . else .id end) | select(.) ],
        conns: ([ ($b.connections.add // [])[] | conn_of("add") ] + [ ($b.connections.delete // [])[] | conn_of("delete") ]) }
    else {loose: ([ $b | .. | objects | (.id?, .sourcePath?, .targetPath?) | strings ] + (if $pid != "" then [$pid] else [] end))}
    end' 2>/dev/null)" || EXPECT=""
  [ -n "$EXPECT" ] || EXPECT='{}'
  pre="$("$DC" pre "$DRAFT_BOT" 2>/dev/null)"
  if [ -n "$pre" ]; then
    { echo "WARNING: before this write, the draft had changes this plugin did not make, or it has never been checked on this machine:"
      printf '%s\n' "$pre" | sed 's/^/  - /'
      echo "Tell the person. Their edits stay in the draft; anything of yours that is gone, offer to put back. Publishing stays blocked until you run draft-check save."; } >&2
  fi
fi

ARGS=(-sS -X "$METHOD" "$BASE$PATH_" -A "$USER_AGENT" -w '\n%{http_code}' --config -)
if [ -n "$BODY" ]; then
  ARGS+=(-H 'Content-Type: application/json' --data-binary "$BODY")
fi

# The header goes in over stdin rather than on the command line, so the token is never an argument
# of a running process and never reaches `ps`.
RESPONSE="$(printf 'header = "Authorization: Token %s"\n' "$TOKEN" | curl "${ARGS[@]}")" \
  || { echo "the request did not complete" >&2; exit 1; }

CODE="${RESPONSE##*$'\n'}"
PAYLOAD="${RESPONSE%$'\n'*}"

# Remember what this plugin wrote: after a draft write, and right after a bot is created. This runs
# before anything is printed, so a caller that stops reading early (`| head`) cannot skip it.
if [ "$CODE" -lt 400 ] 2>/dev/null && [ -x "$DC" ]; then
  if [ -n "$DRAFT_BOT" ]; then
    expf="$(mktemp 2>/dev/null)" && printf '%s' "$EXPECT" > "$expf" || expf=""
    if [ -z "$expf" ] || ! "$DC" post "$DRAFT_BOT" "@$expf" >/dev/null 2>&1; then
      pend="${LANDBOT_STATE_DIR:-$HOME/.landbot}/drafts/$DRAFT_BOT.pending"
      { mkdir -p "$(dirname "$pend")" && echo "after a write, the draft could not be re-read and saved, so what it holds now was never checked" >> "$pend"; } 2>/dev/null \
        || echo "ERROR: could not record that the draft of $DRAFT_BOT was not checked after this write. Do not publish before draft-check diff and save." >&2
      echo "WARNING: could not save a snapshot of the draft of $DRAFT_BOT after this write; publishing stays blocked until draft-check save." >&2
    fi
    [ -n "$expf" ] && rm -f "$expf"
  elif [ "$METHOD" = "POST" ] && { [ "$PATH_" = "/bots" ] || [ "$PATH_" = "/bots/" ]; }; then
    new_id="$(printf '%s' "$PAYLOAD" | jq -r '.data.id // empty' 2>/dev/null)"
    [ -n "$new_id" ] && { "$DC" save "$new_id" >/dev/null 2>&1 || echo "WARNING: could not save the first snapshot of bot $new_id (draft-check save $new_id)" >&2; }
    # Bots created here are the ones `channel` may change live; any other bot gets draft writes.
    case "$new_id" in ''|*/*|.*) ;; *)
      cdir="${LANDBOT_STATE_DIR:-$HOME/.landbot}/created"
      { mkdir -p "$cdir" && date +%s > "$cdir/$new_id"; } 2>/dev/null || echo "WARNING: could not record bot $new_id as created here; channel writes to it will go to the draft" >&2 ;;
    esac
  fi
fi

echo "HTTP $CODE" >&2
if command -v jq >/dev/null 2>&1; then
  printf '%s' "$PAYLOAD" | jq . 2>/dev/null || printf '%s\n' "$PAYLOAD"
else
  printf '%s\n' "$PAYLOAD"
fi

[ "$CODE" -lt 400 ] 2>/dev/null || exit 1
