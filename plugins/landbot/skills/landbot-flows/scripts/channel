#!/usr/bin/env bash
# Read or change the web channel of ONE bot through the v1 channels API, with the user's own token.
#
#   channel get --bot <bot_uuid>                 read the bot's channel (version, style length, created)
#   channel get <channel_id>                     same, by numeric channel id
#   channel v4  --bot <bot_uuid>                 set version 3.1.0 (the v4 web chat) — a WRITE
#   channel css <file.css> --bot <bot_uuid>      set Custom CSS from a file          — a WRITE
#   channel js  <file.js>  --bot <bot_uuid>      set Custom JS from a file           — a WRITE
#   channel js  --clear    --bot <bot_uuid>      remove the channel's Custom JS      — a WRITE
#
# Every css/js write first saves what the channel held to a backup file and prints its path, so
# `channel css|js <backup> --bot <uuid>` puts it back. Custom JS is checked before anything is
# sent (see check_js below), and after the write the published config is read to tell "live for
# visitors" from "stored but not served": Landbot serves Custom JS only to accounts with the Custom
# Code feature, so what the published config carries is the only answer.
#
# The channel is found from the bot; you never type its id. A numeric id may still be given
# (`channel v4 <channel_id> --bot <uuid>`, `channel css <channel_id> <file.css> --bot <uuid>`, or
# `--id <channel_id>`), and then it must be the bot's own channel or nothing is written. The bot's
# uuid, its builder number and a channel uuid are all refused as channel ids.
#
# Guards on every write, because a channel write is live for visitors as soon as it answers:
#   - --bot is required, the bot must have exactly one channel, and that is the channel written.
#   - the channel must be younger than 24 hours: this script is for channels the skill created in
#     this session, never for a customer's existing bot. The limit is fixed; nothing raises it.
#   - a write is LIVE FOR VISITORS AT ONCE: the published config behind the share URL is regenerated
#     by the channels API itself (verified 2026-09-19 on production: version and Custom CSS showed up
#     in index.json without a new publish). So get the user's yes BEFORE running a write, as for a publish.
# Reads only otherwise. Exits non-zero from HTTP 400 up. The token is never printed; `lb` handles it.
set -uo pipefail
HERE="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
LB="$HERE/lb"
HANDOFF="$HERE/handoff"
V1="${LANDBOT_API_V1_URL:-https://api.landbot.io/v1}"
readonly MAX_AGE_H=24

usage() {
  echo "usage: channel get --bot <uuid> | channel get <channel_id> | channel v4 --bot <uuid> | channel css <file.css> --bot <uuid> | channel js <file.js> --bot <uuid> | channel js --clear --bot <uuid>" >&2
  exit 64
}
BACKUP_DIR="${LANDBOT_STATE_DIR:-$HOME/.landbot}/backups"
MAX_JS=60000
is_num() { case "${1:-}" in ''|*[!0-9]*) return 1 ;; *) return 0 ;; esac; }

OP="${1:-}"; [ -n "$OP" ] || usage; shift
BOT=""; ID=""; FILE=""; POS=(); CLEAR=""
while [ "$#" -gt 0 ]; do
  case "$1" in
  --bot) BOT="${2:-}"; [ -n "$BOT" ] || usage; shift 2 ;;
  --id)  ID="${2:-}";  [ -n "$ID" ]  || usage; shift 2 ;;
  --clear) CLEAR=1; shift ;;
  -*)    usage ;;
  *)     POS+=("$1"); shift ;;
  esac
done

# Positional forms: `get <id>`, `v4 <id>`, `css <file>`, `css <id> <file>`.
case "$OP" in
get|v4)
  [ "${#POS[@]}" -le 1 ] || usage
  [ "${#POS[@]}" -eq 1 ] && { [ -z "$ID" ] || usage; ID="${POS[0]}"; } ;;
css)
  case "${#POS[@]}" in
  1) FILE="${POS[0]}" ;;
  2) [ -z "$ID" ] || usage; ID="${POS[0]}"; FILE="${POS[1]}" ;;
  *) usage ;;
  esac
  [ -r "$FILE" ] || { echo "cannot read $FILE" >&2; exit 66; } ;;
js)
  if [ -n "$CLEAR" ]; then [ "${#POS[@]}" -eq 0 ] || usage
  else [ "${#POS[@]}" -eq 1 ] || usage; FILE="${POS[0]}"; [ -r "$FILE" ] || { echo "cannot read $FILE" >&2; exit 66; }; fi ;;
*) usage ;;
esac
[ -z "$CLEAR" ] || [ "$OP" = "js" ] || usage

# Custom JS runs in every visitor's page, so it is checked here, before the network is touched:
#   - a marker comment `lb-js: <name>` so a published script can always be recognised;
#   - no `#{` anywhere (Landbot's firewall answers such a body with a 403, verified 2026-09-22);
#   - at most MAX_JS characters: this is page behaviour, not an application;
#   - nothing that sends data, reads cookies, loads code from elsewhere or evaluates strings.
#     Custom JS from this plugin changes how the chat looks and behaves on the page, never where
#     the visitor's data goes. Integrations belong in the flow (webhook blocks), where they are
#     visible in the builder.
check_js() {
  local f="$1" n bad
  n="$(wc -c < "$f" | tr -d ' ')"
  if [ "$n" -gt "$MAX_JS" ]; then echo "refusing: $f is $n characters; the limit is $MAX_JS. Custom JS here is page behaviour, not an application. Nothing was sent." >&2; return 65; fi
  if ! grep -q 'lb-js:' "$f"; then echo "refusing: $f has no 'lb-js: <name>' marker comment. Add one on the first line (for example /* lb-js: steps 0.3.4 */). Nothing was sent." >&2; return 65; fi
  if grep -qF '#{' "$f"; then echo "refusing: $f contains '#{', which Landbot's firewall rejects with a 403. Write it differently (for example '#' + '{'). Nothing was sent." >&2; return 65; fi
  bad="$(grep -noE 'fetch[[:space:]]*\(|XMLHttpRequest|sendBeacon|WebSocket|EventSource|document\.cookie|(^|[^A-Za-z0-9_$])eval[[:space:]]*\(|new[[:space:]]+Function|import[[:space:]]*\(|createElement\([[:space:]]*.script|<script[^>]*[[:space:]]src[[:space:]]*=|<iframe' "$f" | head -3 | tr '\n' ' ')"
  if [ -n "$bad" ]; then
    echo "refusing: $f uses something Custom JS from this plugin never does (line:match): $bad" >&2
    echo "It may change how the chat looks and behaves on the page; it never sends data, reads cookies, loads code from elsewhere or evaluates strings. Put integrations in the flow (a webhook block). Nothing was sent." >&2
    return 65
  fi
  return 0
}
if [ "$OP" = "js" ] && [ -z "$CLEAR" ]; then check_js "$FILE" || exit $?; fi

if [ -n "$ID" ] && ! is_num "$ID"; then
  echo "refusing: '$ID' is not a channel id. Pass --bot <bot_uuid> and the channel is found for you." >&2
  exit 65
fi
if [ "$OP" != "get" ] && [ -z "$BOT" ]; then
  echo "--bot <bot_uuid> is required for a write: the channel written is the one that bot owns" >&2
  exit 64
fi
[ -n "$BOT" ] || [ -n "$ID" ] || usage

# ---- resolve the bot's channel --------------------------------------------------------------------
ch_uuid=""
if [ -n "$BOT" ]; then
  bot_json="$("$LB" GET "/bots/$BOT" 2>/dev/null)" || { echo "could not read /bots/$BOT on the Bots API (is it a bot uuid of this account?)" >&2; exit 1; }
  n="$(printf '%s' "$bot_json" | jq -r '(.data.channels // []) | length' 2>/dev/null)"
  case "$n" in
  1) ch_uuid="$(printf '%s' "$bot_json" | jq -r '.data.channels[0]')" ;;
  0|'') echo "refusing: bot $BOT reports no channel, so there is nothing to change" >&2; exit 70 ;;
  *) echo "refusing: bot $BOT has $n channels ($(printf '%s' "$bot_json" | jq -r '.data.channels | join(", ")')); this script changes a bot with exactly one" >&2; exit 70 ;;
  esac
  line="$("$HANDOFF" "$BOT" 2>/dev/null)"
  resolved="$(printf '%s' "$line" | tr ' ' '\n' | sed -n 's/^channel=//p')"
  is_num "$resolved" || { echo "refusing: could not find the numeric id of bot $BOT's channel ($ch_uuid)" >&2; exit 1; }
  if [ -n "$ID" ] && [ "$ID" != "$resolved" ]; then
    echo "refusing: $ID is not bot $BOT's channel. Its channel is $resolved. Nothing was written." >&2
    exit 70
  fi
  ID="$resolved"
fi

# v1 answers {"success": true, "channel": {...}}; unwrap it.
read_channel() { LANDBOT_API_URL="$V1" "$LB" GET "/channels/$ID/" 2>/dev/null | jq '.channel // .'; }

summarise() {
  jq -r '"channel:    \(.id)  \(.name // "?")
version:    \(.version // .landbot.version // "?")   (3.1.0 = v4 web chat, 3.0.0 = legacy renderer)
uuid:       \(.uuid // "?")
created:    \(.created_at // "?")
style:      \((.style // "") | length) characters of Custom CSS on the channel
bots:       \([.bots[]? | if type == "object" then .id else . end] | map(tostring) | join(", "))"'
}

body="$(read_channel)" || { echo "could not read channel $ID on $V1 (404 means this account has no channel with that id)" >&2; exit 1; }
if [ "$OP" = "get" ]; then
  printf '%s' "$body" | summarise
  exit 0
fi

# ---- writes -------------------------------------------------------------------------------------
got_uuid="$(printf '%s' "$body" | jq -r '.uuid // empty')"
if [ "$got_uuid" != "$ch_uuid" ]; then
  echo "refusing: channel $ID ($got_uuid) is not a channel of bot $BOT ($ch_uuid). Nothing was written." >&2
  exit 70
fi
created="$(printf '%s' "$body" | jq -r '.created_at // empty')"
cur_version="$(printf '%s' "$body" | jq -r '.version // .landbot.version // "?"')"

case "$created" in
''|*[!0-9.]*) echo "refusing: the channel does not report created_at, so its age cannot be checked" >&2; exit 70 ;;
esac
age_h=$(( ($(date +%s) - ${created%.*}) / 3600 ))
if [ "$age_h" -ge "$MAX_AGE_H" ]; then
  echo "refusing: channel $ID was created about ${age_h} h ago (limit ${MAX_AGE_H} h). This script only changes channels the skill created in this session. Nothing was written." >&2
  echo "For an older bot, the person does it in the Landbot app: open the bot, Design > Custom code > Add CSS, paste the CSS file, Apply, then Publish; the web chat version is switched per account by Landbot." >&2
  exit 70
fi

case "$OP" in
v4)
  if [ "$cur_version" = "3.1.0" ]; then echo "channel $ID is already on 3.1.0; nothing to do."; exit 0; fi
  payload='{"version":"3.1.0"}'
  ;;
css)
  payload="$(jq -Rs '{style: .}' < "$FILE")"
  ;;
js)
  if [ -n "$CLEAR" ]; then payload='{"foot":""}'
  elif grep -qi '<script' "$FILE"; then payload="$(jq -Rs '{foot: .}' < "$FILE")"
  else payload="$( { printf '<script>\n'; cat "$FILE"; printf '\n</script>\n'; } | jq -Rs '{foot: .}')"; fi
  ;;
esac

# Keep what the channel holds now, so the write can be undone with the same command.
if [ "$OP" = "css" ] || [ "$OP" = "js" ]; then
  key="style"; ext="css"; UPOP="CSS"; [ "$OP" = "js" ] && { key="foot"; ext="html"; UPOP="JS"; }
  mkdir -p "$BACKUP_DIR" 2>/dev/null
  bk="$BACKUP_DIR/channel-$ID-$key-$(date -u +%Y%m%dT%H%M%SZ).$ext"
  if printf '%s' "$body" | jq -j --arg k "$key" '.[$k] // ""' > "$bk" 2>/dev/null; then
    if [ -s "$bk" ]; then echo "backup: the channel's previous Custom $UPOP is saved in $bk (put it back with: channel $OP $bk --bot $BOT)"
    else echo "backup: the channel had no Custom $UPOP before this write (undo with: channel ${OP} $( [ "$OP" = js ] && echo "--clear" || echo "<empty file>") --bot $BOT)"; fi
  else
    echo "refusing: could not save a backup of the current Custom $UPOP to $BACKUP_DIR. Nothing was written." >&2; exit 73
  fi
fi

LANDBOT_API_URL="$V1" "$LB" PATCH "/channels/$ID/" "$payload" >/dev/null 2>&1 || { echo "the write was refused; nothing changed" >&2; exit 1; }
after="$(read_channel)" || exit 1
case "$OP" in
v4)  new="$(printf '%s' "$after" | jq -r '.version // .landbot.version // "?"')"
     [ "$new" = "3.1.0" ] || { echo "PATCH answered but the channel still reports version $new" >&2; exit 1; }
     echo "channel $ID (bot $BOT): version $cur_version → 3.1.0 (v4 web chat)." ;;
css) # Landbot trims trailing whitespace from the stored CSS, so compare the two with it trimmed:
     # a file ending in a newline is not a failed push.
     len="$(printf '%s' "$after" | jq -r '(.style // "") | sub("\\s+$"; "") | length')"
     want="$(jq -Rs 'sub("\\s+$"; "") | length' < "$FILE")"
     same="$(jq -n --rawfile f "$FILE" --argjson a "$after" '(($a.style // "") | sub("\\s+$"; "")) == ($f | sub("\\s+$"; ""))')"
     [ "$same" = "true" ] || { echo "PATCH answered but the channel holds $len characters of CSS that differ from the file's $want" >&2; exit 1; }
     echo "channel $ID (bot $BOT): Custom CSS set, $len characters." ;;
js)  same="$(jq -n --argjson a "$after" --argjson p "$payload" '(($a.foot // "") | sub("\\s+$"; "")) == (($p.foot // "") | sub("\\s+$"; ""))')"
     [ "$same" = "true" ] || { echo "PATCH answered but the channel holds Custom JS that differs from what was sent" >&2; exit 1; }
     len="$(printf '%s' "$after" | jq -r '(.foot // "") | length')"
     if [ -n "$CLEAR" ]; then echo "channel $ID (bot $BOT): Custom JS removed."; else echo "channel $ID (bot $BOT): Custom JS set, $len characters."; fi
     # Stored is not served: the published config carries `foot` only on plans with the Custom Code add-on.
     cfg="$(printf '%s' "$after" | jq -r '.config_url // empty')"
     if [ -n "$cfg" ] && [ -z "$CLEAR" ]; then
       served=""; for _ in 1 2 3; do
         served="$(curl -sS -f "$cfg" 2>/dev/null | jq -r '(.foot // "") | length' 2>/dev/null)"; [ "${served:-0}" -gt 0 ] 2>/dev/null && break; sleep 2; done
       if [ "${served:-0}" -gt 0 ] 2>/dev/null; then
         echo "served: the published config carries it ($served characters): live for visitors now."
       else
         echo "NOT SERVED: the Custom JS is stored on the channel, but the published config does not carry it." >&2
         echo "Landbot serves Custom JS only to accounts with the Custom Code feature, and this account's published config does not carry it. Visitors get the chat without it, which is why a behaviour module must never be needed for the chat to work." >&2
         exit 3
       fi
     fi
     echo "Walk the chat in a browser before calling it done: a script can break the page for every visitor, and only a walk shows it." ;;
esac
[ "$OP" = "js" ] && exit 0
echo "This is live for visitors now (the published config is regenerated by the channels API). Run verify-share on the share URL to confirm."
