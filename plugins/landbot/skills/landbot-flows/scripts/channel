#!/usr/bin/env bash
# Read or change the web channel of ONE bot through the v1 channels API, with the user's own token.
#
#   channel get --bot <bot_uuid>                 read the bot's channel (version, style length, created)
#   channel get <channel_id>                     same, by numeric channel id
#   channel v4  --bot <bot_uuid>                 set version 3.1.0 (the v4 web chat) — a WRITE
#   channel css <file.css> --bot <bot_uuid>      set Custom CSS from a file          — a WRITE
#   channel js  <file.js>  --bot <bot_uuid>      set Custom JS: a ready-made module   — a WRITE
#   channel js  <file.js>  --bot <bot_uuid> --custom   set a custom script (see below) — a WRITE
#   channel js  --clear    --bot <bot_uuid>      remove the channel's Custom JS      — a WRITE
#   channel discard        --bot <bot_uuid>      drop the draft THIS plugin wrote     — a WRITE
#   channel publish        --bot <bot_uuid>      make the draft THIS plugin wrote live — a WRITE, live
#   channel preview        --bot <bot_uuid> [--out <file.html>]   a local page: the live chat with the draft's look (reads only)
#   channel back on|off    --bot <bot_uuid>      show or hide the visitor's Back button (design.back_button_visible) — a WRITE
#
# Every css/js write first saves what the channel held to a backup file and prints its path, so
# `channel css|js <backup> --bot <uuid>` puts it back. Custom JS is checked before anything is
# sent (see check_js below), and after the write the published config is read to tell "live for
# visitors" from "stored but not served": Landbot serves Custom JS only to accounts with the Custom
# Code feature, so what the published config carries is the only answer.
#
# The channel is found from the bot; you never type its id. A numeric id may still be given
# (`channel v4 <channel_id> --bot <uuid>`, `channel css <channel_id> <file.css> --bot <uuid>`, or
# `--id <channel_id>`), and then it must be the bot's own channel or nothing is written. The bot's
# uuid, its builder number and a channel uuid are all refused as channel ids.
#
# WHERE a write lands depends on who made the bot and when. No bot is refused for its age.
#   - LIVE, for a bot this plugin created on this machine less than LIVE_WINDOW_H hours ago (the build):
#     `lb` records every successful POST /bots in $LANDBOT_STATE_DIR/created/<bot_uuid> (the epoch it was
#     created). After the window a bot the plugin made is treated like any other bot the person has: its
#     visitors may be real by then. A live write is LIVE FOR VISITORS AT ONCE: the channels API
#     regenerates the published config behind the share URL itself (verified 2026-09-19 on production:
#     version and Custom CSS showed up in index.json without a new publish). Get the yes first.
#   - DRAFT, for any other bot (one the person already had, one made on another machine, or one past the
#     window): the write
#     carries `"autosave": true`, which is what the builder sends, and lands on the channel's draft only.
#     Verified 2026-09-25 on production: the live channel and the published config did not change, and
#     the channel reported `merged: false`. The builder's preview reads the draft (test_config), and so
#     does `channel preview`. Visitors get it after `channel publish` (the person's yes in chat) or the
#     builder's Publish. No flag or variable turns a draft WRITE into a live one; `publish` is its own
#     step. The record is a speed bump, not a security boundary: the skill's rules and the person's yes
#     are what keep writes off bots they did not ask about.
#   - PUBLISH makes THIS plugin's own draft live, the way the builder's Publish does: the same v1 PATCH
#     without `autosave` (Landbot monorepo 2026-09-25: daisho-3 BotLoader save(false); channels/api.py
#     patch merges the draft after a live write). The body is every LANDBOT_FORM_FIELDS key plus `design`,
#     sent explicitly, false, "" and null included: `_update_landbot` fills a MISSING field from the live
#     channel when that live value is truthy, so a field left out could bring a live value back. The
#     settings this plugin changed in the draft (recorded per draft write) come from GET /channels/<id>/copy/;
#     every other field must be equal in the draft and on the live channel, or nothing is written (it would
#     be someone's unreviewed edit), and is sent as the live channel holds it. Verified on production
#     2026-09-26 (probe channel 3517949): all 28 sent, the live channel and the published index.json then
#     carried the draft, merged true. A draft that is not provably ours is never published (exit 75).
#   - PREVIEW writes a local HTML page that boots the same `Landbot.Native` the share page does, with the
#     published config (public: index.json) and the draft's channel settings (style, foot, design,
#     version, texts) laid over it. The flow is the published one. No token from the draft is written.
# Guards on every write:
#   - --bot is required, the bot must have exactly one channel, and that is the channel written.
#   - never over someone's unpublished changes. `merged: false` means the channel holds unpublished
#     changes. A LIVE write copies the live settings over them (verified in the channels API code), so it
#     is refused. A DRAFT write (and `discard`) is refused too, unless those changes are this plugin's own
#     earlier draft on this channel: $LANDBOT_STATE_DIR/channel-drafts/<channel_id> holds when we wrote it,
#     a fingerprint of the LIVE style/foot/version at that moment, and a fingerprint of the WHOLE DRAFT right
#     after our write (read from /test_config/, the config the builder's Preview loads; tokens left out, only
#     a hash is kept). It counts only while it is younger than DRAFT_TTL_H, the live fingerprint is unchanged
#     and the draft is still exactly what we left: any edit the person made since, published or not, fails
#     closed and nothing is written.
#   - the channel is read again right before the PATCH; if `merged` or the live fields moved in between,
#     nothing is written. A builder autosave landing in the second between that read and the PATCH is
#     still possible: closing it needs a compare-and-set on Landbot's side.
# Reads only otherwise. Exits non-zero from HTTP 400 up. The token is never printed; `lb` handles it.
set -uo pipefail
HERE="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
LB="$HERE/lb"
HANDOFF="$HERE/handoff"
V1="${LANDBOT_API_V1_URL:-https://api.landbot.io/v1}"

usage() {
  echo "usage: channel get --bot <uuid> | channel get <channel_id> | channel v4 --bot <uuid> | channel css <file.css> --bot <uuid> | channel js <file.js> --bot <uuid> | channel js --clear --bot <uuid> | channel discard --bot <uuid> | channel publish --bot <uuid> | channel preview --bot <uuid> [--out <file.html>] | channel back on|off --bot <uuid>" >&2
  exit 64
}
STATE_DIR="${LANDBOT_STATE_DIR:-$HOME/.landbot}"
readonly LIVE_WINDOW_H=6 DRAFT_TTL_H=6
# LANDBOT_FORM_FIELDS in services/daisho/channels/constants.py (origin/main 7521e500c, 2026-09-25): the
# channel settings a live PATCH writes. `publish` sends each of them, plus `design`: what this plugin wrote from the draft, the rest as live holds it.
readonly FORM_FIELDS='["format","foot","persistent_menu","typing_options","conditional_proactives","tagline","favicon","hidden_fields","meta_image","meta_title","widget_height","google_analytics_id","fb_pixel_id","head","storage_off","style","text","revisit_off","revisit","branding","welcome","is_legal_consent_enabled","privacy_policy_link","privacy_policy_link_text","privacy_policy_text","launcher_config","version"]'
now_s="$(date +%s)"
# A record file holds the epoch it was written as its first word; anything else is no record.
rec_age_h() { local e; e="$(awk 'NR == 1 { if ($1 ~ /^[0-9]+$/) print $1; exit }' "$1" 2>/dev/null)"; [ -n "$e" ] || { echo 999999; return; }; echo $(( (now_s - e) / 3600 )); }
# The draft as the builder's Preview sees it. Reading it makes the builder's own test chat for this user
# if none exists yet (the same thing pressing Preview does). Exactly five top-level keys are left out of
# the hash: the test chat's and channel's tokens and the Firestore client config (not draft content, and
# not to be written to disk), and `welcome`, the greeting, which belongs to the FLOW: a flow publish
# rewrites it on the live channel and the draft alike (verified 2026-09-26, probe channel 3517949), so it
# must not make our own draft look like someone else's. `publish` never takes it from the draft.
# Every other field counts, so any edit to the draft's channel settings changes the fingerprint.
# Prints nothing when the draft cannot be read, so a failed read never matches a recorded fingerprint.
draft_fp() { local j; j="$(LANDBOT_API_URL="$V1" "$LB" GET "/channels/$1/test_config/" 2>/dev/null \
  | jq -S -c 'select(type == "object" and .test == true) | del(.customerToken, .landbotToken, .channelToken, .firestore, .welcome)' 2>/dev/null)"
  [ -n "$j" ] || return 0
  printf '%s' "$j" | { if command -v sha256sum >/dev/null 2>&1; then sha256sum; else shasum -a 256; fi; } | cut -c1-16; }
fingerprint() { jq -c '[.style // "", .foot // "", (.version // .landbot.version // "")]' | { if command -v sha256sum >/dev/null 2>&1; then sha256sum; else shasum -a 256; fi; } | cut -c1-16; }
BACKUP_DIR="$STATE_DIR/backups"
MAX_JS=60000
is_num() { case "${1:-}" in ''|*[!0-9]*) return 1 ;; *) return 0 ;; esac; }

OP="${1:-}"; [ -n "$OP" ] || usage; shift
BOT=""; ID=""; FILE=""; POS=(); CLEAR=""; CUSTOM=""; BACK=""; OUT=""
while [ "$#" -gt 0 ]; do
  case "$1" in
  --bot) BOT="${2:-}"; [ -n "$BOT" ] || usage; shift 2 ;;
  --id)  ID="${2:-}";  [ -n "$ID" ]  || usage; shift 2 ;;
  --out) OUT="${2:-}"; [ -n "$OUT" ] || usage; shift 2 ;;
  --clear) CLEAR=1; shift ;;
  --custom) CUSTOM=1; shift ;;
  -*)    usage ;;
  *)     POS+=("$1"); shift ;;
  esac
done

# Positional forms: `get <id>`, `v4 <id>`, `css <file>`, `css <id> <file>`.
case "$OP" in
get|v4|discard|publish|preview)
  [ "${#POS[@]}" -le 1 ] || usage
  [ "${#POS[@]}" -eq 1 ] && { [ -z "$ID" ] || usage; ID="${POS[0]}"; } ;;
css)
  case "${#POS[@]}" in
  1) FILE="${POS[0]}" ;;
  2) [ -z "$ID" ] || usage; ID="${POS[0]}"; FILE="${POS[1]}" ;;
  *) usage ;;
  esac
  [ -r "$FILE" ] || { echo "cannot read $FILE" >&2; exit 66; } ;;
back)
  [ "${#POS[@]}" -eq 1 ] || usage
  case "${POS[0]}" in on|off) BACK="${POS[0]}" ;; *) usage ;; esac ;;
js)
  if [ -n "$CLEAR" ]; then [ "${#POS[@]}" -eq 0 ] || usage
  else [ "${#POS[@]}" -eq 1 ] || usage; FILE="${POS[0]}"; [ -r "$FILE" ] || { echo "cannot read $FILE" >&2; exit 66; }; fi ;;
*) usage ;;
esac
[ -z "$CLEAR" ] || [ "$OP" = "js" ] || usage
[ -z "$CUSTOM" ] || { [ "$OP" = "js" ] && [ -z "$CLEAR" ]; } || usage
[ -z "$OUT" ] || [ "$OP" = "preview" ] || usage

# Custom JS runs in every visitor's page, so it is checked here, before the network is touched.
#
# A READY-MADE MODULE (landbot-style/modules/<name>.js, marker `lb-js: <name> <version>`) is accepted when
# its code is exactly the plugin's own copy: only the CONFIG block may differ, and that block may hold
# only plain values (strings, numbers, true/false). So the reviewed code is the code that ships.
#
# ANY OTHER SCRIPT needs --custom, and the person's explicit yes to "a custom script" after being told
# what it does. It is then linted: a marker, at most MAX_JS characters, no `#{` (Landbot's firewall
# answers such a body with a 403, verified 2026-09-22), and none of the common ways a page script sends
# data out, reads cookies, loads or builds code, or navigates away. THE LINT IS NOT A SECURITY BOUNDARY:
# a determined script can get past any pattern list. It catches mistakes, not intent; the review, the
# person's yes and the walk are what stand behind a custom script.
MODULES_DIR="$HERE/../../landbot-style/modules"
sha() { if command -v sha256sum >/dev/null 2>&1; then sha256sum | cut -d' ' -f1; else shasum -a 256 | cut -d' ' -f1; fi; }
# The CONFIG block is recognised only by an opening line that is exactly `var CONFIG = {` and a closing
# line that is exactly `};` (spaces aside). Anything else on those lines is not stripped, so it changes
# the hash, or fails the plain-value check: code cannot ride along on a boundary line.
strip_config() { awk 'BEGIN{c=0; n=0} c==0 && n==0 && /^[[:space:]]*var[[:space:]]+CONFIG[[:space:]]*=[[:space:]]*\{[[:space:]]*$/ {c=1; n=1; print "/*CONFIG*/"; next} c==1 && /^[[:space:]]*\};[[:space:]]*$/ {c=0; next} c==0 {print}' "$1"; }
config_ok() {  # every line inside CONFIG is a plain key: value, a comment or blank
  awk 'BEGIN{c=0; bad=0; n=0}
    c==0 && n==0 && /^[[:space:]]*var[[:space:]]+CONFIG[[:space:]]*=[[:space:]]*\{[[:space:]]*$/ {c=1; n=1; next}
    c==1 && /^[[:space:]]*\};[[:space:]]*$/ {c=0; next}
    c==1 {
      line=$0; sub(/[[:space:]]*\/\/.*$/, "", line)
      if (line ~ /^[[:space:]]*$/) next
      if (line !~ /^[[:space:]]*[A-Za-z_][A-Za-z0-9_]*[[:space:]]*:[[:space:]]*("[^"\\]*"|'"'"'[^'"'"'\\]*'"'"'|-?[0-9]+(\.[0-9]+)?|true|false)[[:space:]]*,?[[:space:]]*$/) { bad=1; print "  " NR ": " $0 }
    }
    END{if (c==1) {bad=1; print "  the CONFIG block is not closed by a line that is exactly };"} exit bad}' "$1"
}
has_odd_line_breaks() {  # U+2028, U+2029 or CR: JavaScript ends lines (and // comments) there, awk and grep do not
  LC_ALL=C grep -q "$(printf '\342\200\250')\|$(printf '\342\200\251')\|$(printf '\r')" "$1"
}
check_module() {  # 0 = the plugin's own module with plain CONFIG values; 2 = not a module; 65 = refused
  local f="$1" name ref
  if has_odd_line_breaks "$f"; then
    echo "refusing: $f contains a U+2028/U+2029 line separator or a carriage return, which JavaScript reads as a line break where this check does not. Nothing was sent." >&2
    return 65
  fi
  name="$(sed -n 's/.*lb-js:[[:space:]]*\([a-z][a-z0-9-]*\).*/\1/p' "$f" | head -1)"
  ref="$MODULES_DIR/$name.js"
  [ -n "$name" ] && [ -f "$ref" ] || return 2
  if [ "$(strip_config "$f" | sha)" != "$(strip_config "$ref" | sha)" ]; then
    echo "refusing: $f says it is the '$name' module but its code differs from the plugin's copy ($ref). In a module only the CONFIG block may change. For other code use --custom. Nothing was sent." >&2
    return 65
  fi
  local badlines; badlines="$(config_ok "$f")" || {
    echo "refusing: the CONFIG block of $f holds something other than plain values (strings, numbers, true/false):" >&2
    printf '%s\n' "$badlines" >&2; echo "Nothing was sent." >&2; return 65; }
  echo "module: $name, the plugin's own code with your CONFIG values."
  return 0
}
check_custom_js() {
  local f="$1" n bad
  n="$(wc -c < "$f" | tr -d ' ')"
  if [ "$n" -gt "$MAX_JS" ]; then echo "refusing: $f is $n characters; the limit is $MAX_JS. Custom JS here is page behaviour, not an application. Nothing was sent." >&2; return 65; fi
  if ! grep -q 'lb-js:' "$f"; then echo "refusing: $f has no 'lb-js: <name>' marker comment. Add one on the first line (for example /* lb-js: my-behaviour 1 */). Nothing was sent." >&2; return 65; fi
  if grep -qF '#{' "$f"; then echo "refusing: $f contains '#{', which Landbot's firewall rejects with a 403. Write it differently (for example '#' + '{'). Nothing was sent." >&2; return 65; fi
  if has_odd_line_breaks "$f"; then echo "refusing: $f contains a U+2028/U+2029 line separator or a carriage return; save it with plain line breaks. Nothing was sent." >&2; return 65; fi
  bad="$(grep -noE 'fetch[[:space:]]*\(|XMLHttpRequest|sendBeacon|WebSocket|EventSource|RTCPeerConnection|document[[:space:]]*\.[[:space:]]*cookie|document[[:space:]]*\[|window[[:space:]]*\[|self[[:space:]]*\[|globalThis|(^|[^A-Za-z0-9_$])eval[[:space:]]*\(|new[[:space:]]+Function|Function[[:space:]]*\(|import[[:space:]]*\(|importScripts|set(Timeout|Interval)[[:space:]]*\([[:space:]]*["'"'"'`]|createElement[[:space:]]*\([[:space:]]*["'"'"'`](script|iframe|img|image|form|link|object|embed|audio|video|source|meta|base)|new[[:space:]]+Image|\.src[[:space:]]*=[^=]|\.srcset[[:space:]]*=|\.href[[:space:]]*=[^=]|\.action[[:space:]]*=[^=]|\.submit[[:space:]]*\(|location[[:space:]]*(\.|\[|=)|window[[:space:]]*\.[[:space:]]*open|postMessage|atob[[:space:]]*\(|fromCharCode|\\x[0-9A-Fa-f]{2}|\\u00[0-9A-Fa-f]{2}|innerHTML[[:space:]]*=[^=]*<(img|script|iframe|form|link|object|embed)|<script[^>]*[[:space:]]src[[:space:]]*=|<iframe|<img|<form' "$f" | head -3 | tr '\n' ' ')"
  if [ -n "$bad" ]; then
    echo "refusing: $f uses something a custom script from this plugin may not (line:match): $bad" >&2
    case "$bad" in *'\u00'*|*'\x'*) echo "An escape such as \\u00b7 or \\x41 is refused because escapes can hide code. Write the character itself instead (for example · or A)." >&2 ;; esac
    echo "A custom script may change how the chat looks and behaves on the page; it may not send data, read cookies, load or build code, add media or forms that fetch, or navigate. Put integrations in the flow (a webhook block). Nothing was sent." >&2
    return 65
  fi
  echo "custom script: passed the lint. The lint is not a security boundary: say what the script does and get the person's yes to a custom script before this write."
  return 0
}
if [ "$OP" = "js" ] && [ -z "$CLEAR" ]; then
  [ -n "$BOT" ] || { echo "--bot <bot_uuid> is required for a write: the channel written is the one that bot owns" >&2; exit 64; }
  if [ -n "$CUSTOM" ]; then mrc=2; else check_module "$FILE"; mrc=$?; fi
  case "$mrc" in
  0) ;;
  2) if [ -z "$CUSTOM" ]; then
       echo "refusing: $FILE is not one of the plugin's ready-made modules ($(ls "$MODULES_DIR" 2>/dev/null | sed -n 's/\.js$//p' | tr '\n' ' ')). A custom script needs --custom and the person's explicit yes to a custom script. Nothing was sent." >&2
       exit 65
     fi
     check_custom_js "$FILE" || exit $? ;;
  *) exit "$mrc" ;;
  esac
fi

if [ -n "$ID" ] && ! is_num "$ID"; then
  echo "refusing: '$ID' is not a channel id. Pass --bot <bot_uuid> and the channel is found for you." >&2
  exit 65
fi
if [ "$OP" != "get" ] && [ "$OP" != "preview" ] && [ -z "$BOT" ]; then
  echo "--bot <bot_uuid> is required for a write: the channel written is the one that bot owns" >&2
  exit 64
fi
[ -n "$BOT" ] || [ -n "$ID" ] || usage

# ---- resolve the bot's channel --------------------------------------------------------------------
ch_uuid=""
if [ -n "$BOT" ]; then
  bot_json="$("$LB" GET "/bots/$BOT" 2>/dev/null)" || { echo "could not read /bots/$BOT on the Bots API (is it a bot uuid of this account?)" >&2; exit 1; }
  n="$(printf '%s' "$bot_json" | jq -r '(.data.channels // []) | length' 2>/dev/null)"
  case "$n" in
  1) ch_uuid="$(printf '%s' "$bot_json" | jq -r '.data.channels[0]')" ;;
  0|'') echo "refusing: bot $BOT reports no channel, so there is nothing to change" >&2; exit 70 ;;
  *) echo "refusing: bot $BOT has $n channels ($(printf '%s' "$bot_json" | jq -r '.data.channels | join(", ")')); this script changes a bot with exactly one" >&2; exit 70 ;;
  esac
  line="$("$HANDOFF" "$BOT" 2>/dev/null)"
  resolved="$(printf '%s' "$line" | tr ' ' '\n' | sed -n 's/^channel=//p')"
  is_num "$resolved" || { echo "refusing: could not find the numeric id of bot $BOT's channel ($ch_uuid)" >&2; exit 1; }
  if [ -n "$ID" ] && [ "$ID" != "$resolved" ]; then
    echo "refusing: $ID is not bot $BOT's channel. Its channel is $resolved. Nothing was written." >&2
    exit 70
  fi
  ID="$resolved"
fi

# v1 answers {"success": true, "channel": {...}}; unwrap it.
read_channel() { LANDBOT_API_URL="$V1" "$LB" GET "/channels/$ID/" 2>/dev/null | jq '.channel // .'; }

summarise() {
  jq -r --arg mode "$1" '"channel:    \(.id)  \(.name // "?")
version:    \(.version // .landbot.version // "?")   (3.1.0 = v4 web chat, 3.0.0 = legacy renderer)
uuid:       \(.uuid // "?")
created:    \(.created_at // "?")
style:      \((.style // "") | length) characters of Custom CSS on the live channel
back:       \(if (.design | type) == "object" then (if .design.back_button_visible == false then "hidden (design.back_button_visible false)" else "shown (hover-only on phones unless the CSS forces it)" end) else "?" end)
pending:    \(if .merged == false then "YES: unpublished changes are waiting in the builder" elif .merged == true then "no unpublished changes" else "unknown" end)
writes go:  \($mode)
bots:       \([.bots[]? | if type == "object" then .id else . end] | map(tostring) | join(", "))"'
}

body="$(read_channel)" || { echo "could not read channel $ID on $V1 (404 means this account has no channel with that id)" >&2; exit 1; }
merged="$(printf '%s' "$body" | jq -r 'if (.merged | type) == "boolean" then (.merged | tostring) else "" end')"
DRAFT_REC="$STATE_DIR/channel-drafts/$ID"
# Our draft is gone once the channel is merged again (published or discarded): forget it.
[ "$merged" = "true" ] && rm -f "$DRAFT_REC" "$DRAFT_REC".* 2>/dev/null
live_fp="$(printf '%s' "$body" | fingerprint)"
MODE=draft
if [ -n "$BOT" ] && [ -f "$STATE_DIR/created/$BOT" ] && [ "$(rec_age_h "$STATE_DIR/created/$BOT")" -lt "$LIVE_WINDOW_H" ]; then MODE=live; fi
# Our own pending draft counts only while its record is young and the live channel has not moved.
OURS=""
if [ "$merged" = "false" ] && [ -f "$DRAFT_REC" ] && [ "$(rec_age_h "$DRAFT_REC")" -lt "$DRAFT_TTL_H" ] \
   && [ "$(awk 'NR == 1 {print $2}' "$DRAFT_REC")" = "$live_fp" ]; then
  want_draft="$(awk 'NR == 1 {print $3}' "$DRAFT_REC")"
  now_draft="$(draft_fp "$ID")"
  [ -n "$want_draft" ] && [ -n "$now_draft" ] && [ "$now_draft" = "$want_draft" ] && OURS=1
fi
# The draft as the API returns it (every channel field, the ones the builder's Preview does not show too).
read_copy() { LANDBOT_API_URL="$V1" "$LB" GET "/channels/$ID/copy/" 2>/dev/null | jq -c '.channel // empty' 2>/dev/null; }
# A hash of every channel setting in a draft copy (not its counters): last_look reads the copy again and
# compares, so an edit to a setting the draft fingerprint does not see still stops publish and discard.
copy_fp() { printf '%s' "$1" | jq -S -c --argjson f "$FORM_FIELDS" '. as $c | reduce ($f + ["design", "ie_compat"])[] as $k ({}; . + {($k): $c[$k]})' 2>/dev/null \
  | { if command -v sha256sum >/dev/null 2>&1; then sha256sum; else shasum -a 256; fi; } | cut -c1-16; }
COPY_WANT=""
# What THIS plugin changed in the draft: every draft write adds its setting (style, foot, version or
# design) to $DRAFT_REC.keys.
wrote_keys() { sort -u "$DRAFT_REC.keys" 2>/dev/null | jq -R -c 'select(. == "style" or . == "foot" or . == "version" or . == "design")' | jq -s -c '.'; }
# Fields where the draft differs from the live channel although this plugin did not change them: someone's
# unpublished edit (settings the builder's Preview does not show, such as the page head or the meta title,
# are not in the draft fingerprint) or a live change since. Two fields are left out: `welcome`, the flow's
# greeting (a flow publish rewrites it), and `design` when this plugin did not change it (Landbot's merge
# after a live write does not save the draft's design, so the draft can hold an older one).
foreign_fields() { jq -n -r --argjson c "$1" --argjson l "$body" --argjson f "$FORM_FIELDS" --argjson w "$2" \
  '[($f + ["design", "ie_compat"])[] as $k | select(($w | index($k)) == null and $k != "welcome" and $k != "design") | select($c[$k] != $l[$k]) | $k] | join(", ")'; }

if [ "$OP" = "get" ]; then
  if [ -z "$BOT" ]; then where="unknown without --bot"
  elif [ "$MODE" = live ]; then where="LIVE (this plugin created the bot on this machine less than $LIVE_WINDOW_H h ago)"
  else where="the DRAFT (a bot this plugin did not create here): visitors get it after channel publish, on the person's yes"; fi
  printf '%s' "$body" | summarise "$where"
  if [ "$merged" = "false" ]; then
    if [ -n "$OURS" ]; then
      gcopy="$(read_copy)"; gforeign=""; [ -n "$gcopy" ] && gforeign="$(foreign_fields "$gcopy" "$(wrote_keys)")"
      if [ -z "$gcopy" ]; then echo "draft:      this plugin's own by its fingerprint; the full draft could not be read, so publish and discard will refuse"
      elif [ -n "$gforeign" ]; then echo "draft:      this plugin's, plus changes it did not make in: $gforeign. Publish and discard refuse; the person publishes or discards in the builder"
      else echo "draft:      this plugin's own (channel preview shows it; channel publish makes it live; channel discard drops it)"; fi
    else echo "draft:      NOT provably this plugin's (the person's builder edits, or ours from over $DRAFT_TTL_H h ago): channel preview shows it; publish and discard refuse"; fi
  fi
  exit 0
fi

# ---- preview: a local page, the live chat with the draft's look (reads only) ------------------------
# The share page is `new Landbot.Native(<the published index.json>)` (read 2026-09-26 on
# landbot.pro/v3/H-3517949-…/index.html). This page does the same with the draft's channel settings laid
# over the published config. The flow (greeting and every step after it) stays the published one. Only
# these keys come from the draft, so no token of the builder's test chat reaches the file.
PREVIEW_FIELDS='["style","foot","design","version","use_surrogate_interaction","text","tagline","typing_options","persistent_menu","branding","logo","brand_name","is_legal_consent_enabled","privacy_policy_link","privacy_policy_link_text","privacy_policy_text","storage_off","revisit_off","revisit","hidden_fields","conditional_proactives","launcher","launcher_tracking"]'
if [ "$OP" = "preview" ]; then
  if [ -n "$BOT" ] && [ "$(printf '%s' "$body" | jq -r '.uuid // empty')" != "$ch_uuid" ]; then echo "refusing: channel $ID is not bot $BOT's channel" >&2; exit 70; fi
  cfg_url="$(printf '%s' "$body" | jq -r '.config_url // empty')"
  [ -n "$cfg_url" ] || { echo "channel $ID does not report where its published config is (config_url); no preview can be built" >&2; exit 1; }
  pub="$(curl -sS -f "$cfg_url" 2>/dev/null | jq -c 'select(type == "object" and (.channelToken | type) == "string")' 2>/dev/null)"
  [ -n "$pub" ] || { echo "could not read the published config at $cfg_url; no preview was written" >&2; exit 1; }
  if [ "$merged" = "false" ]; then
    draft="$(LANDBOT_API_URL="$V1" "$LB" GET "/channels/$ID/test_config/" 2>/dev/null | jq -c --argjson k "$PREVIEW_FIELDS" 'select(type == "object" and .test == true) | with_entries(select(.key as $x | $k | index($x)))' 2>/dev/null)"
    [ -n "$draft" ] || { echo "could not read the draft (test_config) of channel $ID; no preview was written" >&2; exit 1; }
  else draft='{}'; fi
  comp="$(jq -n -c --argjson p "$pub" --argjson d "$draft" '$p + $d')"
  shown="$(jq -n -r --argjson p "$pub" --argjson d "$draft" '[$d | keys[] as $k | select($d[$k] != $p[$k]) | $k] | join(", ")')"
  if [ -z "$OUT" ]; then mkdir -p "$STATE_DIR/previews" 2>/dev/null; OUT="$STATE_DIR/previews/channel-$ID-$(date -u +%Y%m%dT%H%M%SZ).html"; fi
  mod="https://cdn.landbot.io/landbot-3/landbot-3.0.0.mjs"   # what the share page loads (2026-09-26)
  # `<` is written as < inside the JSON, so nothing in a CSS or JS string can close the <script>.
  {
    printf '<!DOCTYPE html>\n<html lang="en">\n<head>\n<meta charset="UTF-8">\n<meta name="viewport" content="width=device-width, initial-scale=1">\n<meta name="robots" content="noindex">\n'
    printf '<title>DRAFT preview · channel %s</title>\n' "$ID"
    printf '<!-- channel preview: the published config of channel %s with its draft laid over (%s). Written %s. The flow is the published one. -->\n' "$ID" "${shown:-no draft}" "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    printf '</head>\n<body>\n<script>\nvar LB_PREVIEW_CONFIG = '
    printf '%s' "$comp" | sed 's/</\\u003c/g'
    printf ';\nfunction setupLandbot() { window._landbot = new Landbot.Native(LB_PREVIEW_CONFIG); }\n</script>\n'
    printf '<script async defer onload="setupLandbot()" type="module" src="%s"></script>\n</body>\n</html>\n' "$mod"
  } > "$OUT" 2>/dev/null || { echo "could not write $OUT" >&2; exit 73; }
  echo "preview:    $OUT"
  if [ "$merged" = "false" ]; then
    echo "shows:      the published chat with the draft's ${shown:-settings, which equal the published ones}"
  else
    echo "shows:      no pending draft: the same look visitors get on the share URL"
  fi
  echo "not shown:  flow changes (greeting, questions, steps): the page runs the PUBLISHED flow. Only the look and channel texts come from the draft."
  echo "open it:    over http on this machine, not as a file (a file:// page stalls at the loader; the in-app browser does not run local files):"
  echo "            serve $(dirname "$OUT") on 127.0.0.1 and open http://127.0.0.1:<port>/$(basename "$OUT")"
  echo "note:       the page talks to the LIVE bot like the share URL: answering in it starts a real chat in the inbox. The draft's Custom JS runs in it, as in the builder's Preview."
  exit 0
fi

# ---- writes -------------------------------------------------------------------------------------
got_uuid="$(printf '%s' "$body" | jq -r '.uuid // empty')"
if [ "$got_uuid" != "$ch_uuid" ]; then
  echo "refusing: channel $ID ($got_uuid) is not a channel of bot $BOT ($ch_uuid). Nothing was written." >&2
  exit 70
fi
cur_version="$(printf '%s' "$body" | jq -r '.version // .landbot.version // "?"')"
builder="$(printf '%s' "${line:-}" | tr ' ' '\n' | sed -n 's/^builder=//p')"
BUILDER_URL="${LANDBOT_APP_URL:-https://app.landbot.io}/gui/bot/${builder:-<builder>}/builder"

# Last look before any write: if the live channel, the pending flag or (for our own draft) the draft
# moved since the first read, stop.
last_look() {
  local again; again="$(read_channel)" || { echo "could not re-read channel $ID before writing; nothing was written" >&2; exit 1; }
  if [ "$(printf '%s' "$again" | jq -r '.merged | tostring')" != "$merged" ] || [ "$(printf '%s' "$again" | fingerprint)" != "$live_fp" ] \
     || { [ -n "$OURS" ] && [ "$(draft_fp "$ID")" != "$want_draft" ]; } \
     || { [ -n "$COPY_WANT" ] && [ "$(copy_fp "$(read_copy)")" != "$COPY_WANT" ]; }; then
    echo "refusing: channel $ID changed while this write was being prepared (someone is working on it). Nothing was written; read it again with channel get." >&2
    exit 75
  fi
}

if [ "$OP" = "discard" ]; then
  if [ "$merged" != "false" ]; then echo "channel $ID has no unpublished changes; nothing to discard."; exit 0; fi
  if [ -z "$OURS" ]; then
    echo "refusing: the unpublished changes on channel $ID are not (or no longer provably) this plugin's own draft from the last $DRAFT_TTL_H h. Discarding would throw away the person's own work; they can do it in the builder. Nothing was written." >&2
    exit 75
  fi
  dcopy="$(read_copy)"; [ -n "$dcopy" ] || { echo "could not read the draft of channel $ID (/copy/); nothing was discarded" >&2; exit 1; }
  others="$(foreign_fields "$dcopy" "$(wrote_keys)")"; COPY_WANT="$(copy_fp "$dcopy")"
  if [ -n "$others" ]; then
    echo "refusing: the draft of channel $ID also holds changes this plugin did not make, in: $others. Discarding would throw them away. The person publishes or discards them in the builder ($BUILDER_URL). Nothing was written." >&2
    exit 75
  fi
  last_look
  # Run on production 2026-09-26 and 2026-09-28 (probe channel 3517949): it copies the live channel's
  # settings over the channel draft and nothing else; a flow edit pending in the same bot's draft was
  # still there afterwards (2026-09-28). See REFERENCE.md.
  LANDBOT_API_URL="$V1" "$LB" PATCH "/channels/$ID/discard/" '{}' >/dev/null 2>&1 || { echo "the discard was refused; nothing changed" >&2; exit 1; }
  # The discard answer can report the old merged flag; read the channel again.
  again="$(read_channel)" || exit 1
  if [ "$(printf '%s' "$again" | jq -r '.merged')" = "true" ]; then
    rm -f "$DRAFT_REC" "$DRAFT_REC".* 2>/dev/null
    echo "channel $ID (bot $BOT): draft discarded; the builder and the preview show the live design again."; exit 0
  fi
  echo "the discard answered but channel $ID still reports unpublished changes" >&2; exit 1
fi

if [ "$OP" = "publish" ]; then
  case "$merged" in
  true) echo "channel $ID has no unpublished changes; nothing to publish. Visitors already get what the channel holds."; exit 0 ;;
  false) ;;
  *) echo "refusing: channel $ID does not report whether it holds unpublished changes (merged), so nothing can be published safely. Nothing was written." >&2; exit 70 ;;
  esac
  if [ -z "$OURS" ]; then
    echo "refusing: the unpublished changes on channel $ID are not (or no longer provably) this plugin's own draft from the last $DRAFT_TTL_H h: they are the person's builder edits, or ours from too long ago. Publishing would put work live that nobody reviewed here. Nothing was written." >&2
    echo "They can publish in the builder ($BUILDER_URL); channel get --bot $BOT and channel preview --bot $BOT show what is pending." >&2
    exit 75
  fi
  # The draft, as the builder would publish it. Every field must be there: a field left out of a live PATCH
  # is filled from the LIVE channel when the live value is truthy, so a missing one could bring back what
  # the draft changed. Refuse rather than send a partial body.
  copy="$(read_copy)"
  [ -n "$copy" ] || { echo "could not read the draft of channel $ID (/copy/); nothing was written" >&2; exit 1; }
  [ "$(printf '%s' "$copy" | jq -r --argjson id "$ID" '(.id == $id) and ((.design | type) == "object") | tostring')" = "true" ] \
    || { echo "refusing: the draft read for channel $ID is not this channel's, or has no design object. Nothing was written." >&2; exit 70; }
  missing="$(printf '%s' "$copy" | jq -r --argjson f "$FORM_FIELDS" '[$f[] as $k | select(has($k) | not) | $k] | join(", ")')"
  [ -z "$missing" ] || { echo "refusing: the draft of channel $ID does not report $missing. Sent without them, Landbot would fill them from the live channel. Nothing was written." >&2; exit 70; }
  # These two checks rely on GET /channels/<id>/ (live) and GET /channels/<id>/copy/ (draft) both returning
  # every LANDBOT_FORM_FIELDS key, nullable ones included (both did on 2026-09-26, probe channel 3517949).
  # If Landbot ever drops a field from either answer, publish refuses with exit 70 and names that field:
  # compare the two answers and FORM_FIELDS above before changing anything here.
  live_missing="$(printf '%s' "$body" | jq -r --argjson f "$FORM_FIELDS" '[($f + ["design"])[] as $k | select(has($k) | not) | $k] | join(", ")')"
  [ -z "$live_missing" ] || { echo "refusing: the live channel $ID does not report $live_missing, so no complete backup (undo) can be kept. Nothing was written." >&2; exit 70; }
  # The copy must be the draft we fingerprinted: its look agrees with the draft the builder previews.
  tc="$(LANDBOT_API_URL="$V1" "$LB" GET "/channels/$ID/test_config/" 2>/dev/null | jq -c 'select(type == "object" and .test == true) | {style, foot, version, design}' 2>/dev/null)"
  agree="$(jq -n -r --argjson c "$copy" --argjson t "${tc:-null}" 'if $t == null then "unread" else ([$c.style, $c.foot, $c.version, $c.design] == [$t.style, $t.foot, $t.version, $t.design] | tostring) end')"
  if [ "$agree" != "true" ]; then
    echo "refusing: the draft copy of channel $ID does not match the draft the builder previews ($agree): it moved between the reads, or the two disagree. Nothing was written; read it again with channel get." >&2
    exit 75
  fi
  # Only what THIS plugin changed in the draft comes from the draft. Every other field must hold the same
  # value in the draft and on the live channel (foreign_fields), and is sent as the live channel holds it.
  wrote="$(wrote_keys)"
  if [ "$(printf '%s' "${wrote:-[]}" | jq -r 'length')" = "0" ]; then
    echo "refusing: there is no record of which settings this plugin changed in the draft of channel $ID (a draft from an older build). Nothing was written; discard it and write it again, or the person publishes in the builder ($BUILDER_URL)." >&2
    exit 75
  fi
  others="$(foreign_fields "$copy" "$wrote")"; COPY_WANT="$(copy_fp "$copy")"
  if [ -n "$others" ]; then
    echo "refusing: the draft of channel $ID also differs from the live channel in: $others. This plugin did not change that: it is someone's unpublished edit, or the live channel changed since. Publishing would put it live unreviewed. Nothing was written." >&2
    echo "The person publishes or discards it in the builder ($BUILDER_URL)." >&2
    exit 75
  fi
  if [ "$(printf '%s' "$wrote" | jq -r 'index("design") != null')" = "true" ] \
     && [ "$(jq -n -r --argjson c "$copy" --argjson l "$body" '(($c.design | del(.back_button_visible)) == ($l.design | del(.back_button_visible))) | tostring')" != "true" ]; then
    echo "refusing: the live design of channel $ID changed since this plugin's Back setting went to the draft; publishing the draft's design would undo that change. Nothing was written; discard the draft and set Back again." >&2
    exit 75
  fi
  # Every field explicit (false, "" and null included): what this plugin wrote from the draft, the rest as
  # the live channel holds it (equal to the draft, checked above). `ie_compat` is not a form field: it is
  # compared (above) but never sent, so neither the publish nor its undo changes it.
  payload="$(jq -n -c --argjson c "$copy" --argjson l "$body" --argjson f "$FORM_FIELDS" --argjson w "$wrote" \
    'def pick($k): if ($w | index($k)) != null then $c[$k] else $l[$k] end; (reduce $f[] as $k ({}; . + {($k): pick($k)})) + {design: pick("design")}')"
  nsent="$(printf '%s' "$payload" | jq -r 'keys | length')"
  [ "$nsent" = "$(jq -n -r --argjson f "$FORM_FIELDS" '$f | length + 1')" ] || { echo "refusing: built a body of $nsent fields, not every field; nothing was written" >&2; exit 70; }
  from_draft="$(printf '%s' "$wrote" | jq -r 'join(", ")')"
  # Undo = the live channel's same fields, sent live. Kept before the write.
  mkdir -p "$BACKUP_DIR" 2>/dev/null
  bk="$(mktemp "$BACKUP_DIR/channel-$ID-live-$(date -u +%Y%m%dT%H%M%SZ)-XXXXXX" 2>/dev/null)" || bk=""
  [ -n "$bk" ] && printf '%s' "$body" | jq -c --argjson f "$FORM_FIELDS" '. as $c | (reduce $f[] as $k ({}; . + {($k): $c[$k]})) + {design: $c.design}' > "$bk" 2>/dev/null && [ -s "$bk" ] \
    || { echo "refusing: could not save a backup of the live channel to $BACKUP_DIR. Nothing was written." >&2; exit 73; }
  UNDO="$(printf 'LANDBOT_API_URL=%q %q PATCH /channels/%s/ %q' "$V1" "$LB" "$ID" "@$bk")"
  echo "backup: the live channel's $nsent fields are saved in $bk (undo, itself a live write that needs a yes: $UNDO)"
  last_look
  LANDBOT_API_URL="$V1" "$LB" PATCH "/channels/$ID/" "$payload" >/dev/null 2>&1 || { echo "the publish was refused; nothing changed (read it again with channel get)" >&2; exit 1; }
  after="$(read_channel)" || { echo "PUBLISHED, NOT VERIFIED: channel $ID could not be read back. Undo: $UNDO" >&2; exit 1; }
  # Landbot trims trailing whitespace from the CSS and JS it stores; compare strings with it trimmed.
  diffk="$(jq -n -r --argjson a "$after" --argjson p "$payload" 'def t: if type == "string" then sub("\\s+$"; "") else . end;
    [$p | keys[] as $k | select(($a | has($k) | not) or (($a[$k] | t) != ($p[$k] | t))) | $k] | join(", ")')"
  mg_after="$(printf '%s' "$after" | jq -r '.merged | tostring')"
  if [ -n "$diffk" ] || [ "$mg_after" != "true" ]; then
    echo "PUBLISHED, NOT VERIFIED: channel $ID answered the publish, but ${diffk:+the live channel differs from what was sent in: $diffk; }merged is $mg_after. Tell the person and check it with channel get. Undo: $UNDO" >&2
    exit 1
  fi
  rm -f "$DRAFT_REC" "$DRAFT_REC".* 2>/dev/null
  echo "channel $ID (bot $BOT): the draft is live ($from_draft from the draft; the other fields as they were). The live channel equals what was sent on all $nsent fields, and it reports no unpublished changes."
  # What visitors load: the published config behind the share URL must carry every setting taken from the draft.
  cfg="$(printf '%s' "$after" | jq -r '.config_url // empty')"
  [ -n "$cfg" ] || { echo "NOT VERIFIED: the channel did not report where its published config is, so what visitors load is unchecked. Undo: $UNDO" >&2; exit 4; }
  state="unread"; for _ in 1 2 3 4; do
    state="$(curl -sS -f "$cfg" 2>/dev/null | jq -r --argjson p "$payload" --argjson w "$wrote" 'def t: if type == "string" then sub("\\s+$"; "") else . end;
      def n: if . == null then "" else . end; . as $s |
      [ $w[] as $k | if ($s[$k] | n | t) == ($p[$k] | n | t) then empty
        elif $k == "foot" and ($s.foot | n | length) == 0 then "nofoot" else $k end ] | join(" ")' 2>/dev/null || echo unread)"
    [ -z "$state" ] && break; sleep 2; done
  case "$state" in
  "")     echo "served: the published config ($cfg) carries the draft's $from_draft: live for visitors now." ;;
  nofoot) echo "served: the published config carries everything taken from the draft except the Custom JS."
          echo "NOT SERVED: the Custom JS is stored but the published config does not carry it: Landbot serves Custom JS only to accounts with the Custom Code feature." >&2; exit 3 ;;
  *)      echo "NOT VERIFIED: the published config ($cfg) does not carry the draft's $state yet. Custom CSS is dropped on Sandbox plans. Check again in a minute; do not call it live. Undo: $UNDO" >&2; exit 5 ;;
  esac
  echo "Walk the share URL in a browser before calling it done."
  exit 0
fi

case "$merged" in
true) ;;
false)
  if [ "$MODE" = live ]; then
    echo "refusing: channel $ID holds unpublished changes (made in the builder or through the API). A live write copies the live settings over them, so they would be lost. Ask the person to publish or discard them in the builder first. Nothing was written." >&2
    exit 75
  elif [ -z "$OURS" ]; then
    echo "refusing: channel $ID holds unpublished changes this plugin did not make (or can no longer prove it made) (the person is editing it in the builder, or did and did not publish). A write now would mix with their work. Ask them to publish or discard those changes first. Nothing was written." >&2
    exit 75
  fi ;;
*) echo "refusing: channel $ID does not report whether it holds unpublished changes (merged), so no write can be made safely. Nothing was written." >&2; exit 70 ;;
esac

case "$OP" in
back)
  # The design object is written whole: a key left out falls back to Landbot's default. So it is read,
  # this one key changed, and sent back; nothing else in it may differ. Over a pending draft (even our own)
  # the draft's design is not the one read here, so that case waits for channel publish or discard.
  if [ "$merged" != "true" ]; then
    echo "refusing: channel $ID holds unpublished changes; the Back setting is written together with the whole design, which would mix with them. Publish or discard them first (channel publish or channel discard for this plugin's own draft). Nothing was written." >&2
    exit 75
  fi
  printf '%s' "$body" | jq -e '(.design | type) == "object"' >/dev/null 2>&1 || { echo "refusing: channel $ID reports no design object to change. Nothing was written." >&2; exit 70; }
  want_back=true; [ "$BACK" = off ] && want_back=false
  cur_back="$(printf '%s' "$body" | jq -r 'if .design.back_button_visible == false then "false" else "true" end')"
  if [ "$cur_back" = "$want_back" ] && [ "$(printf '%s' "$body" | jq -r '.design | has("back_button_visible")')" = "true" ]; then echo "channel $ID: the Back button is already $BACK; nothing to do."; exit 0; fi
  design_before="$(printf '%s' "$body" | jq -S -c '.design')"
  payload="$(printf '%s' "$body" | jq -c --argjson b "$want_back" '{design: (.design + {back_button_visible: $b})}')"
  ;;
v4)
  if [ "$cur_version" = "3.1.0" ] && [ "$merged" = "true" ]; then echo "channel $ID is already on 3.1.0; nothing to do."; exit 0; fi
  payload='{"version":"3.1.0"}'
  ;;
css)
  payload="$(jq -Rs '{style: .}' < "$FILE")"
  ;;
js)
  if [ -n "$CLEAR" ]; then payload='{"foot":""}'
  elif grep -qi '<script' "$FILE"; then payload="$(jq -Rs '{foot: .}' < "$FILE")"
  else payload="$( { printf '<script>\n'; cat "$FILE"; printf '\n</script>\n'; } | jq -Rs '{foot: .}')"; fi
  ;;
esac
[ "$MODE" = draft ] && payload="$(printf '%s' "$payload" | jq -c '. + {autosave: true}')"

# Keep what the field holds now, so the write can be undone with the same command. With no pending
# changes the draft equals the live channel, so the live value is the right backup; when continuing our
# own draft, the right backup is what we wrote last time.
if [ "$OP" = "css" ] || [ "$OP" = "js" ]; then
  key="style"; ext="css"; UPOP="CSS"; [ "$OP" = "js" ] && { key="foot"; ext="html"; UPOP="JS"; }
  mkdir -p "$BACKUP_DIR" 2>/dev/null
  bk="$(mktemp "$BACKUP_DIR/channel-$ID-$key-$(date -u +%Y%m%dT%H%M%SZ)-XXXXXX" 2>/dev/null)" || bk=""   # atomic: never reuses a name
  [ -n "$bk" ] || { echo "refusing: could not create a backup file in $BACKUP_DIR. Nothing was written." >&2; exit 73; }
  if [ "$merged" = "false" ] && [ -f "$DRAFT_REC.$key" ]; then src="the draft's"; cp "$DRAFT_REC.$key" "$bk" 2>/dev/null; ok=$?
  else src="the channel's"; printf '%s' "$body" | jq -j --arg k "$key" '.[$k] // ""' > "$bk" 2>/dev/null; ok=$?; fi
  if [ "$ok" = 0 ]; then
    if [ -s "$bk" ]; then echo "backup: $src previous Custom $UPOP is saved in $bk (put it back with: channel $OP $bk --bot $BOT)"
    else echo "backup: $src Custom $UPOP was empty before this write (undo with: channel ${OP} $( [ "$OP" = js ] && echo "--clear" || echo "<empty file>") --bot $BOT)"; fi
  else
    echo "refusing: could not save a backup of the current Custom $UPOP to $BACKUP_DIR. Nothing was written." >&2; exit 73
  fi
fi

last_look
if [ "$OP" = "back" ]; then
  again="$(read_channel)" || { echo "could not re-read channel $ID before writing; nothing was written" >&2; exit 1; }
  [ "$(printf '%s' "$again" | jq -S -c '.design')" = "$design_before" ] || { echo "refusing: the design of channel $ID changed while this write was being prepared. Nothing was written; read it again with channel get." >&2; exit 75; }
fi
resp="$(LANDBOT_API_URL="$V1" "$LB" PATCH "/channels/$ID/" "$payload" 2>/dev/null)" || { echo "the write was refused; nothing changed" >&2; exit 1; }

# ---- a draft write: check the draft took it, and that the live channel did not move ----------------
if [ "$MODE" = draft ]; then
  draft="$(printf '%s' "$resp" | jq '.channel // .' 2>/dev/null)"
  case "$OP" in
  back) got="$(printf '%s' "$draft" | jq -r '.design.back_button_visible | tostring')"; [ "$got" = "$want_back" ] || { echo "PATCH answered but the draft reports back_button_visible $got" >&2; exit 1; }
        # the PATCH answer is an echo; the draft the builder's Preview loads is the proof (not `// default`: false is a value)
        got="$(LANDBOT_API_URL="$V1" "$LB" GET "/channels/$ID/test_config/" 2>/dev/null | jq -r '.design.back_button_visible | tostring' 2>/dev/null)"
        [ "$got" = "$want_back" ] || { echo "PATCH answered but the draft the builder previews reports back_button_visible '${got:-unreadable}'; check it in the builder" >&2; exit 1; } ;;
  v4)  got="$(printf '%s' "$draft" | jq -r '.version // .landbot.version // "?"')"; [ "$got" = "3.1.0" ] || { echo "PATCH answered but the draft reports version $got" >&2; exit 1; } ;;
  css) same="$(jq -n --rawfile f "$FILE" --argjson a "$draft" '(($a.style // "") | sub("\\s+$"; "")) == ($f | sub("\\s+$"; ""))')"
       [ "$same" = "true" ] || { echo "PATCH answered but the draft holds different CSS than the file" >&2; exit 1; } ;;
  js)  same="$(jq -n --argjson a "$draft" --argjson p "$payload" '(($a.foot // "") | sub("\\s+$"; "")) == (($p.foot // "") | sub("\\s+$"; ""))')"
       [ "$same" = "true" ] || { echo "PATCH answered but the draft holds different Custom JS than was sent" >&2; exit 1; } ;;
  esac
  after="$(read_channel)" || exit 1
  moved="$(jq -n --argjson b "$body" --argjson a "$after" '[$b.style, $b.foot, ($b.version // $b.landbot.version), $b.design] != [$a.style, $a.foot, ($a.version // $a.landbot.version), $a.design]')"
  if [ "$moved" = "true" ]; then
    echo "WARNING: the live channel changed during a draft write. That is not expected; check the share URL now and tell the person." >&2
    exit 1
  fi
  dfp="$(draft_fp "$ID")"
  # Which setting this write changed in the draft: `publish` takes only these from the draft.
  case "$OP" in css) wk=style ;; js) wk=foot ;; v4) wk=version ;; back) wk=design ;; esac
  if [ -n "$dfp" ]; then mkdir -p "$(dirname "$DRAFT_REC")" 2>/dev/null && printf '%s %s %s\n' "$(date +%s)" "$live_fp" "$dfp" > "$DRAFT_REC" && printf '%s\n' "$wk" >> "$DRAFT_REC.keys"
  else rm -f "$DRAFT_REC" "$DRAFT_REC.keys"; echo "note: could not read the draft back, so the next write to this bot's design waits until the person publishes or discards it in the builder." >&2; fi
  if [ "$OP" = "css" ] || [ "$OP" = "js" ]; then printf '%s' "$payload" | jq -j --arg k "$key" '.[$k] // ""' > "$DRAFT_REC.$key" 2>/dev/null; fi
  case "$OP" in
  back) echo "channel $ID (bot $BOT): Back button $BACK, saved to the DRAFT." ;;
  v4)  echo "channel $ID (bot $BOT): version 3.1.0 (v4 web chat) saved to the DRAFT." ;;
  css) echo "channel $ID (bot $BOT): Custom CSS saved to the DRAFT, $(jq -Rs 'sub("\\s+$"; "") | length' < "$FILE") characters." ;;
  js)  if [ -n "$CLEAR" ]; then echo "channel $ID (bot $BOT): Custom JS removed in the DRAFT."; else echo "channel $ID (bot $BOT): Custom JS saved to the DRAFT. Visitors get it after channel publish (or Publish in the builder), and only on accounts with the Custom Code feature."; fi ;;
  esac
  echo "Visitors still get the published version: nothing is live. Show it with channel preview --bot $BOT (the live chat with this draft's look). Make it live with channel publish --bot $BOT once the person says yes; drop it with channel discard --bot $BOT. In the builder ($BUILDER_URL) Preview shows it too; a builder tab opened before this write publishes the copy it loaded, so reload it first."
  exit 0
fi

# ---- a live write -------------------------------------------------------------------------------
after="$(read_channel)" || exit 1
case "$OP" in
back) same="$(jq -n --argjson a "$after" --argjson d "$design_before" --argjson b "$want_back" '($a.design.back_button_visible == $b) and (($a.design | del(.back_button_visible)) == ($d | del(.back_button_visible)))')"
     [ "$same" = "true" ] || { echo "PATCH answered but the channel's design is not the one sent (Back setting or another design key differs); check it with channel get" >&2; exit 1; }
     echo "channel $ID (bot $BOT): Back button $BACK. On phones it stays invisible unless the Custom CSS forces it (landbot-style Step 2b)." ;;
v4)  new="$(printf '%s' "$after" | jq -r '.version // .landbot.version // "?"')"
     [ "$new" = "3.1.0" ] || { echo "PATCH answered but the channel still reports version $new" >&2; exit 1; }
     echo "channel $ID (bot $BOT): version $cur_version → 3.1.0 (v4 web chat)." ;;
css) # Landbot trims trailing whitespace from the stored CSS, so compare the two with it trimmed:
     # a file ending in a newline is not a failed push.
     len="$(printf '%s' "$after" | jq -r '(.style // "") | sub("\\s+$"; "") | length')"
     want="$(jq -Rs 'sub("\\s+$"; "") | length' < "$FILE")"
     same="$(jq -n --rawfile f "$FILE" --argjson a "$after" '(($a.style // "") | sub("\\s+$"; "")) == ($f | sub("\\s+$"; ""))')"
     [ "$same" = "true" ] || { echo "PATCH answered but the channel holds $len characters of CSS that differ from the file's $want" >&2; exit 1; }
     echo "channel $ID (bot $BOT): Custom CSS set, $len characters." ;;
js)  same="$(jq -n --argjson a "$after" --argjson p "$payload" '(($a.foot // "") | sub("\\s+$"; "")) == (($p.foot // "") | sub("\\s+$"; ""))')"
     [ "$same" = "true" ] || { echo "PATCH answered but the channel holds Custom JS that differs from what was sent" >&2; exit 1; }
     len="$(printf '%s' "$after" | jq -r '(.foot // "") | length')"
     if [ -n "$CLEAR" ]; then echo "channel $ID (bot $BOT): Custom JS removed."; else echo "channel $ID (bot $BOT): Custom JS set, $len characters."; fi
     # Stored is not served: the published config carries `foot` only on plans with the Custom Code add-on.
     cfg="$(printf '%s' "$after" | jq -r '.config_url // empty')"
     if [ -z "$CLEAR" ]; then
       if [ -z "$cfg" ]; then
         echo "NOT VERIFIED: the channel did not report where its published config is, so whether visitors get this script is unknown." >&2
         exit 4
       fi
       state=""; for _ in 1 2 3 4; do
         state="$(curl -sS -f "$cfg" 2>/dev/null | jq -r --argjson p "$payload" '(.foot // "") as $f | if ($f | length) == 0 then "none" elif ($f | sub("\\s+$"; "")) == (($p.foot // "") | sub("\\s+$"; "")) then "same" else "other" end' 2>/dev/null)"
         [ "$state" = "same" ] && break; sleep 2; done
       case "$state" in
       same)  echo "served: the published config carries exactly this script ($len characters): live for visitors now." ;;
       none)  echo "NOT SERVED: the Custom JS is stored on the channel, but the published config does not carry it." >&2
              echo "Landbot serves Custom JS only to accounts with the Custom Code feature, and this account's published config does not carry it. Visitors get the chat without it, which is why a behaviour module must never be needed for the chat to work." >&2
              exit 3 ;;
       *)     echo "NOT VERIFIED: the published config carries a different script than the one just stored (or could not be read). Visitors may still get the previous one. Check again in a minute; do not call it live." >&2
              exit 5 ;;
       esac
     fi
     echo "Walk the chat in a browser before calling it done: a script can break the page for every visitor, and only a walk shows it." ;;
esac
[ "$OP" = "js" ] && exit 0
# Stored is not served: the channels API regenerates the published config behind the share URL, and only
# that config says what visitors load (Custom CSS is dropped on Sandbox plans). Read it back.
cfg="$(printf '%s' "$after" | jq -r '.config_url // empty')"
if [ -z "$cfg" ]; then
  echo "NOT VERIFIED: the channel did not report where its published config is, so what visitors get is unchecked. Run verify-share on the share URL; do not call it live." >&2
  exit 4
fi
state=""; for _ in 1 2 3 4; do
  case "$OP" in
  css)  state="$(curl -sS -f "$cfg" 2>/dev/null | jq -r --rawfile f "$FILE" 'if (((.style // "") | sub("\\s+$"; "")) == ($f | sub("\\s+$"; ""))) then "same" else "other" end' 2>/dev/null)" ;;
  v4)   state="$(curl -sS -f "$cfg" 2>/dev/null | jq -r 'if (.version | tostring) == "3.1.0" then "same" else "other" end' 2>/dev/null)" ;;
  back) state="$(curl -sS -f "$cfg" 2>/dev/null | jq -r --argjson b "$want_back" 'if (.design.back_button_visible == $b) or ($b and (.design | has("back_button_visible") | not)) then "same" else "other" end' 2>/dev/null)" ;;
  esac
  [ "$state" = "same" ] && break; sleep 2; done
if [ "$state" != "same" ]; then
  echo "NOT VERIFIED: the published config ($cfg) does not carry this change yet (or could not be read). Custom CSS is dropped on Sandbox plans. Check again with verify-share in a minute; do not call it live." >&2
  exit 5
fi
echo "served: the published config carries it: live for visitors now. Walk the share URL before calling it done."
