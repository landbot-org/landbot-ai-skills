#!/usr/bin/env bash
# Check what the visitor actually gets, from the outside, without an API token:
#
#   verify-share <share-url | H-<id>-<code>> [expected-substring-of-css]
#
# Reads the published channel config (index.json) behind a share URL and answers three things:
#   1. is the channel on the v4 renderer (use_surrogate_interaction / version 3.1.0)?
#   2. is Custom CSS present in the PUBLISHED config (it is dropped on Sandbox plans)?
#   3. does that CSS contain the marker you expect (proves the last Publish carried your paste)?
# Exit 0 only when all three hold. Anything else is a real failure, not a warning.
# It does not render the page: computed styles and anchor counts are checked in the browser
# console on the share URL (see SKILL.md, "Verify").
set -uo pipefail
IN="${1:-}"; MARK="${2:-}"
if [ -z "$IN" ]; then echo "usage: verify-share <share-url | H-<id>-<code>> [expected-css-substring]" >&2; exit 64; fi
SHARE_CODE=""; [[ "$IN" =~ (H-[0-9]+-[A-Z0-9]+) ]] && SHARE_CODE="${BASH_REMATCH[1]}"
if [ -z "$SHARE_CODE" ]; then echo "no share code (H-<id>-<code>) found in: $IN" >&2; exit 65; fi
CHANNEL_ID="$(printf '%s' "$SHARE_CODE" | cut -d- -f2)"
# The published config sits in the bucket named after the share URL's host. Landbot serves each brand on
# one of landbot.pro, landbot.online and landbot.site; a bare share code does not say which, so all three
# are tried. The legacy hosts (chats.landbot.io, landbot.io) predate the v4 web chat this skill styles.
# LANDBOT_CONFIG_BASE (one base, or several separated by spaces) replaces the list, for tests.
GCS="https://storage.googleapis.com"
if [ -n "${LANDBOT_CONFIG_BASE:-}" ]; then BASES="$LANDBOT_CONFIG_BASE"
elif [[ "$IN" =~ ^https?://(landbot\.(pro|online|site))/ ]]; then BASES="$GCS/${BASH_REMATCH[1]}/v3"
elif [[ "$IN" =~ ^https?:// ]]; then
  echo "unsupported share host in $IN: v4 share pages are served on landbot.pro, landbot.online or landbot.site. Take the share URL from the handoff line." >&2; exit 65
else BASES="$GCS/landbot.pro/v3 $GCS/landbot.online/v3 $GCS/landbot.site/v3"; fi
body=""; CONFIG_URL=""; tried=""
for base in $BASES; do
  CONFIG_URL="$base/$SHARE_CODE/index.json"; tried="$tried $CONFIG_URL"
  body="$(curl -sS -f "$CONFIG_URL" 2>/dev/null)" && [ -n "$body" ] && break
  body=""
done
if [ -z "$body" ]; then echo "could not read the published config at:$tried (not published yet, or the share code is wrong)" >&2; exit 1; fi

v4="$(printf '%s' "$body" | jq -r '.use_surrogate_interaction // empty')"
ver="$(printf '%s' "$body" | jq -r '.version // empty')"
style_len="$(printf '%s' "$body" | jq -r '(.style // "") | length')"
ok=0
echo "channel:   $CHANNEL_ID"
echo "config:    $CONFIG_URL"
echo "version:   ${ver:-?}   use_surrogate_interaction: ${v4:-?}"
echo "style:     ${style_len} characters in the published config"
if [ "$v4" != "true" ] && [ "$ver" != "3.1.0" ]; then
  echo "FAIL: this channel is not on the v4 renderer. Custom CSS will not render here. Stop and report it." >&2; ok=1
fi
if [ "$style_len" = "0" ]; then
  echo "FAIL: no Custom CSS in the published config. Either Publish was not clicked, or the plan is Sandbox (Custom CSS is dropped)." >&2; ok=1
fi
if [ -n "$MARK" ]; then
  # Not `jq … | grep -q`: under pipefail, grep -q stops reading at the first match, jq is killed by
  # SIGPIPE (141) and the pipeline counts as failed, so a marker that IS published was reported
  # missing on most large styles (16 of 20 live channels, 2026-09-25). Test the string in the shell.
  style="$(printf '%s' "$body" | jq -r '.style // ""')"
  if [[ "$style" == *"$MARK"* ]]; then
    echo "marker:    found"
  else
    echo "FAIL: the published CSS does not contain '$MARK'. The paste did not reach Publish." >&2; ok=1
  fi
fi
[ "$ok" = 0 ] && echo "OK: v4 renderer and Custom CSS are live at $CONFIG_URL. Now check the share URL itself in a browser (see SKILL.md)."
exit "$ok"
