#!/usr/bin/env bash
# Provisional: the anchor catalog belongs in the Landbot MCP server, which should serve it the way
# it serves the block catalog. Until it does, this copies it into landbot-style.
#
# web-chat owns the catalog in js-packages: packages/@landbot-ui/web-chat/src/shared/ui/styling/
# anchors-catalog.json, an array of { part, role, description }. Visitors get the web-chat version
# landbot-3 pins, so the table is taken from that version's tag, not from js-packages main. This
# rewrites the table between the anchors:start and anchors:end markers of references/style-catalog.md.
#
#   scripts/sync-anchor-catalog --landbot <checkout> --js-packages <checkout>
#       reads the version in services/landbot-3/package.json on the landbot checkout's origin/main,
#       then that version's @landbot-ui/web-chat@<version> tag in js-packages (fetch both first)
#   scripts/sync-anchor-catalog <anchors-catalog.json>
#   either form with --check first: exit 1 when the table differs, write nothing
set -euo pipefail
cd "$(dirname -- "${BASH_SOURCE[0]}")/.."
DOC=plugins/landbot/skills/landbot-style/references/style-catalog.md
SRC_PATH=packages/@landbot-ui/web-chat/src/shared/ui/styling/anchors-catalog.json
USAGE="usage: $0 [--check] --landbot <checkout> --js-packages <checkout> | [--check] <anchors-catalog.json>"

MODE=write; [ "${1:-}" = "--check" ] && { MODE=check; shift; }
if [ "${1:-}" = "--landbot" ] && [ "${3:-}" = "--js-packages" ] && [ -n "${2:-}" ] && [ -n "${4:-}" ]; then
  version="$(git -C "$2" show origin/main:services/landbot-3/package.json | jq -er '.dependencies["@landbot-ui/web-chat"]')"
  json="$(git -C "$4" show "@landbot-ui/web-chat@$version:$SRC_PATH")"
  from="web-chat $version, the version landbot-3 pins"
elif [ -n "${1:-}" ] && [ "${1#--}" = "$1" ]; then
  json="$(cat -- "$1")"; from="$1"
else
  echo "$USAGE" >&2; exit 64
fi

table="$(jq -r '
  if type != "array" or any(.[]; type != "object" or (.part|type) != "string" or (.role|type) != "string")
  then error("expected [{part, role, description}]") else . end
  | "<!-- anchors:start — generated by scripts/sync-anchor-catalog; do not edit by hand -->",
    "",
    "\(length) parts.",
    "",
    "| Part | Role | What it is |",
    "|---|---|---|",
    (.[] | "| `\(.part)` | \(.role) | \(.description | gsub("\\|"; "\\|") | gsub("<"; "`<") | gsub(">"; ">`")) |"),
    "",
    "<!-- anchors:end -->"' <<<"$json")"

grep -q '^<!-- anchors:start' "$DOC" && grep -q '^<!-- anchors:end -->' "$DOC" \
  || { echo "$DOC has no anchors:start / anchors:end markers" >&2; exit 1; }
want="$(TABLE="$table" awk '
  /^<!-- anchors:start/ { print ENVIRON["TABLE"]; skip=1; next }
  /^<!-- anchors:end -->/ { skip=0; next }
  !skip' "$DOC")"

if [ "$MODE" = check ]; then
  if [ "$want" = "$(cat "$DOC")" ]; then echo "anchor catalog is in sync with $from"
  else echo "$DOC differs from $from; run scripts/sync-anchor-catalog" >&2; exit 1; fi
else
  printf '%s\n' "$want" > "$DOC"; echo "wrote $DOC from $from"
fi
