#!/usr/bin/env bash
# The anchor list in landbot-style's catalog is copied from web-chat, which owns it in
# js-packages: packages/@landbot-ui/web-chat/src/shared/ui/styling/anchors-catalog.json,
# an array of { part, role, description }. This rewrites the table between the
# anchors:start and anchors:end markers of references/style-catalog.md from that file.
#
#   scripts/sync-anchor-catalog <anchors-catalog.json>
#   scripts/sync-anchor-catalog --js-packages <checkout> [ref]   read it with git show (ref: origin/main)
#   either form with --check first: exit 1 when the table differs, write nothing
set -euo pipefail
cd "$(dirname -- "${BASH_SOURCE[0]}")/.."
DOC=plugins/landbot/skills/landbot-style/references/style-catalog.md
SRC_PATH=packages/@landbot-ui/web-chat/src/shared/ui/styling/anchors-catalog.json

MODE=write; [ "${1:-}" = "--check" ] && { MODE=check; shift; }
if [ "${1:-}" = "--js-packages" ]; then
  [ -n "${2:-}" ] || { echo "usage: $0 [--check] --js-packages <checkout> [ref]" >&2; exit 64; }
  json="$(git -C "$2" show "${3:-origin/main}:$SRC_PATH")"
  from="js-packages ${3:-origin/main} ($(git -C "$2" show "${3:-origin/main}:packages/@landbot-ui/web-chat/package.json" | jq -r '"web-chat " + .version'))"
elif [ -n "${1:-}" ]; then
  json="$(cat -- "$1")"; from="$1"
else
  echo "usage: $0 [--check] <anchors-catalog.json> | --js-packages <checkout> [ref]" >&2; exit 64
fi

table="$(jq -r --arg from "$from" '
  if type != "array" or any(.[]; type != "object" or (.part|type) != "string" or (.role|type) != "string")
  then error("expected [{part, role, description}]") else . end
  | "<!-- anchors:start — generated by scripts/sync-anchor-catalog from \($from); do not edit by hand -->",
    "",
    "\(length) parts.",
    "",
    "| Part | Role | What it is |",
    "|---|---|---|",
    (.[] | "| `\(.part)` | \(.role) | \(.description | gsub("\\|"; "\\|") | gsub("<"; "`<") | gsub(">"; ">`")) |"),
    "",
    "<!-- anchors:end -->"' <<<"$json")"

grep -q '^<!-- anchors:start' "$DOC" && grep -q '^<!-- anchors:end -->' "$DOC" \
  || { echo "$DOC has no anchors:start / anchors:end markers" >&2; exit 1; }
want="$(TABLE="$table" awk '
  /^<!-- anchors:start/ { print ENVIRON["TABLE"]; skip=1; next }
  /^<!-- anchors:end -->/ { skip=0; next }
  !skip' "$DOC")"

# The generator line names its source; compare everything else.
strip() { grep -v '^<!-- anchors:start'; }
if [ "$MODE" = check ]; then
  if [ "$(printf '%s\n' "$want" | strip)" = "$(strip < "$DOC")" ]; then echo "anchor catalog is in sync with $from"
  else echo "$DOC differs from $from; run scripts/sync-anchor-catalog" >&2; exit 1; fi
else
  printf '%s\n' "$want" > "$DOC"; echo "wrote $DOC from $from"
fi
